---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Desarrollo en Godot & Simulación | Pascual Ruiz Benítez">
  <div class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <span class="badge badge-gamedev">Pilar 3</span>
    <h1 style="margin-top: 1rem; margin-bottom: 1rem;">Desarrollo en Godot & Simulación</h1>
    <p style="max-width: 650px; color: var(--color-text-secondary); margin-bottom: 2rem;">
      Desarrollo de prototipos interactivos, arquitectura orientada a componentes, patrones de máquinas de estados y shaders en Godot Engine.
    </p>
    <div class="glass-panel" style="padding: 2rem; border-left: 4px solid var(--accent-gamedev);">
      <h3 style="margin-bottom: 0.5rem;">Prototipos & Showcase Interactivo</h3>
      <p style="color: var(--color-text-muted);">Esta sección se completará en profundidad durante la Tarea 6 del backlog.</p>
    </div>
  </div>
</BaseLayout>
