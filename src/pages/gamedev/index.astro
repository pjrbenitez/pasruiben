---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/gamedev/GameCard.astro';
import WasmContainer from '../../components/gamedev/WasmContainer.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('gamedev');
projects.sort((a, b) => a.data.order - b.data.order);

const technicalTenets = [
  {
    title: 'Composición sobre Herencia',
    desc: 'Uso extensivo de nodos y componentes especializados en Godot (Hitboxes, Hurtboxes, Controllers) para evitar jerarquías rígidas y acopladas.',
  },
  {
    title: 'Determinismo y Físicas Fijas',
    desc: 'Lógica de juego desacoplada de la tasa de refresco visual mediante el bucle _physics_process a 60 Hz para garantizar colisiones idénticas en cualquier hardware.',
  },
  {
    title: 'Shaders y Renderizado Eficiente',
    desc: 'Escritura de shaders GLSL optimizados para cálculo en un único pase y uso de MultiMeshInstance para agrupar miles de entidades en una sola llamada de dibujado.',
  },
  {
    title: 'Despliegue WebAssembly',
    desc: 'Configuración y optimización de proyectos para compilación cruzada hacia la web (Wasm + WebGL 2.0) sin comprometer la latencia de entrada.',
  },
];
---

<BaseLayout
  title="Desarrollo en Godot & Simulación | Pascual Ruiz Benítez"
  description="Showcase técnico de videojuegos y simulaciones interactivas en Godot Engine 4 (GDScript, C#, Shaders GLSL y WebAssembly)."
>
  <div class="gamedev-page">
    <div class="container">
      <!-- Hero Section -->
      <div class="gamedev-hero">
        <div class="badge badge-gamedev">Pilar 3 &bull; Game Development & Simulation</div>
        <h1 class="gamedev-title">
          Desarrollo en Godot Engine, <span class="gradient-text-gamedev">Simulación de Físicas</span> y WebAssembly
        </h1>
        <p class="gamedev-intro">
          Ingeniería de software aplicada al desarrollo interactivo y videojuegos en <strong>Godot Engine 4</strong> (GDScript y C#). Énfasis en arquitecturas limpias, máquinas de estados jerárquicas, optimización gráfica y rendimiento de 60 cuadros por segundo constantes.
        </p>

        <!-- Benchmarks Strip -->
        <div class="gamedev-metrics-strip glass-panel">
          <div class="metric-block">
            <span class="m-val m-purple">60 FPS</span>
            <span class="m-label">FRAME BUDGET &lt; 16ms</span>
          </div>
          <div class="metric-block">
            <span class="m-val">&lt; 40</span>
            <span class="m-label">DRAW CALLS OPTIMIZADAS</span>
          </div>
          <div class="metric-block">
            <span class="m-val">C# / GDScript</span>
            <span class="m-label">ARQUITECTURA HÍBRIDA</span>
          </div>
          <div class="metric-block">
            <span class="m-val">Wasm Ready</span>
            <span class="m-label">WEBGL 2.0 NATIVO</span>
          </div>
        </div>
      </div>

      <!-- Contenedor WebAssembly Interactivo -->
      <WasmContainer title="Chronicles of Aethelgard" />

      <!-- Listado de Proyectos y Devlogs -->
      <div class="projects-section">
        <div class="projects-header">
          <div>
            <span class="badge badge-gamedev">Proyectos & Prototipos</span>
            <h2 class="projects-title">Desarrollos en Godot Engine</h2>
          </div>
          <p class="projects-subtitle">
            Explora cada proyecto para profundizar en sus patrones de arquitectura, optimizaciones de código y shaders.
          </p>
        </div>

        <div class="projects-grid">
          {projects.map((project) => (
            <GameCard project={project} />
          ))}
        </div>
      </div>

      <!-- Principios Técnicos de Desarrollo de Juegos -->
      <div class="tenets-section glass-panel">
        <div class="tenets-header">
          <span class="badge badge-gamedev">Metodología de Ingeniería</span>
          <h3>Principios de Arquitectura en Videojuegos</h3>
        </div>

        <div class="tenets-grid">
          {technicalTenets.map((tenet) => (
            <div class="tenet-card">
              <div class="tenet-dot"></div>
              <div>
                <h4 class="tenet-title">{tenet.title}</h4>
                <p class="tenet-desc">{tenet.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .gamedev-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .gamedev-hero {
    max-width: 820px;
    margin-bottom: var(--space-12);
  }

  .gamedev-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .gamedev-intro {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .gamedev-metrics-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .gamedev-metrics-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m-val {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .m-purple {
    color: var(--accent-gamedev);
  }

  .m-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  /* Projects Section */
  .projects-section {
    margin-bottom: var(--space-16);
  }

  .projects-header {
    margin-bottom: var(--space-8);
  }

  .projects-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .projects-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Tenets Section */
  .tenets-section {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }

  .tenets-header {
    margin-bottom: var(--space-6);
  }

  .tenets-header h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }

  .tenets-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .tenets-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tenet-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .tenet-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-gamedev);
    box-shadow: 0 0 8px var(--accent-gamedev);
    flex-shrink: 0;
    margin-top: 6px;
  }

  .tenet-title {
    font-size: var(--text-base);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .tenet-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
