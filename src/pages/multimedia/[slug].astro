---
import { getCollection } from 'astro:content';
import MultimediaDetailView from '../../views/MultimediaDetailView.astro';

export async function getStaticPaths() {
  const works = await getCollection('multimedia');
  const enWorks = works.filter((w) => w.slug.startsWith('en/'));
  return enWorks.map((work) => ({
    params: { slug: work.slug.replace(/^en\//, '') },
    props: { work },
  }));
}

const { work } = Astro.props;
---

<MultimediaDetailView work={work} locale="en" />
