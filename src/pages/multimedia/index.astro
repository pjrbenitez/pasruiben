---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Multimedia & Piano Clásico | Pascual Ruiz Benítez">
  <div class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <span class="badge badge-media">Pilar 4</span>
    <h1 style="margin-top: 1rem; margin-bottom: 1rem;">Multimedia, Piano Clásico & Vídeo</h1>
    <p style="max-width: 650px; color: var(--color-text-secondary); margin-bottom: 2rem;">
      Interpretaciones acústicas de piano clásico de alto rigor interpretativo y producción audiovisual técnica con gradación de color profesional.
    </p>
    <div class="glass-panel" style="padding: 2rem; border-left: 4px solid var(--accent-media);">
      <h3 style="margin-bottom: 0.5rem;">Auditorio & Reproductor Lossless</h3>
      <p style="color: var(--color-text-muted);">Esta sección se completará en profundidad durante la Tarea 7 del backlog.</p>
    </div>
  </div>
</BaseLayout>
