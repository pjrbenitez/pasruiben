---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PerformanceCard from '../../components/multimedia/PerformanceCard.astro';
import AudioPlayer from '../../components/multimedia/AudioPlayer.astro';
import { getCollection } from 'astro:content';

const works = await getCollection('multimedia');
works.sort((a, b) => a.data.order - b.data.order);

const disciplines = [
  {
    title: 'Rigor Técnico & Polifonía',
    desc: 'La interpretación del repertorio pianístico de alta dificultad exige disciplina arquitectónica, articulación independiente de voces y control milimétrico del peso muscular.',
  },
  {
    title: 'Cadena de Audio Acústico Lossless',
    desc: 'Grabaciones sin trucos artificiales: microfonía estéreo calibrada (técnica ORTF), preamplificadores transparentes y masterización en alta resolución (96 kHz / 24-bit).',
  },
  {
    title: 'Postproducción & Color Grading',
    desc: 'Edición cinematográfica en DaVinci Resolve Studio con espacios de color gestionados, sincronización de código de tiempo y etalonaje sobre perfiles Log.',
  },
  {
    title: 'Sensibilidad y Pensamiento Sistémico',
    desc: 'La música clásica y el desarrollo de software comparten un principio común: la construcción de estructuras abstractas complejas gobernadas por reglas matemáticas y estéticas.',
  },
];
---

<BaseLayout
  title="Auditorio Multimedia: Piano Clásico & Edición de Vídeo | Pascual Ruiz Benítez"
  description="Interpretaciones de piano clásico en alta fidelidad acústica (Chopin, Bach) y flujo de trabajo en postproducción audiovisual y color grading en DaVinci Resolve."
>
  <div class="multimedia-page">
    <div class="container">
      <!-- Section Hero -->
      <div class="multimedia-hero">
        <div class="badge badge-media">Pilar 4 &bull; Classical Music & Video Production</div>
        <h1 class="multimedia-title">
          Auditorio Multimedia, <span class="gradient-text-media">Piano Clásico</span> y Postproducción Audiovisual
        </h1>
        <p class="multimedia-intro">
          Interpretaciones acústicas de piano clásico de alta exigencia técnica combinadas con producción audiovisual profesional. Un testimonio vivo de que la disciplina de la ingeniería y la profundidad artística se retroalimentan mutuamente.
        </p>

        <!-- Studio Specs Strip -->
        <div class="studio-specs-strip glass-panel">
          <div class="spec-col">
            <span class="s-val s-gold">96 kHz / 24-bit</span>
            <span class="s-lbl">AUDIO HI-RES LOSSLESS</span>
          </div>
          <div class="spec-col">
            <span class="s-val">ORTF Stereo</span>
            <span class="s-lbl">MICROFONÍA ACÚSTICA</span>
          </div>
          <div class="spec-col">
            <span class="s-val">DaVinci Resolve</span>
            <span class="s-lbl">COLOR GRADING 10-BIT</span>
          </div>
          <div class="spec-col">
            <span class="s-val">Zero Compresión</span>
            <span class="s-lbl">RANGO DINÁMICO REAL</span>
          </div>
        </div>
      </div>

      <!-- Reproductor Principal de Audio Hi-Res -->
      <AudioPlayer
        title="Nocturno en Do Menor, Op. 48 No. 1"
        composer="Frédéric Chopin"
        duration="6:15"
        category="Grabación Destacada &bull; 96 kHz Lossless"
      />

      <!-- Catálogo de Obras y Proyectos Audiovisuales -->
      <div class="works-section">
        <div class="works-header">
          <div>
            <span class="badge badge-media">Catálogo Curado</span>
            <h2 class="works-title">Interpretaciones & Proyectos de Vídeo</h2>
          </div>
          <p class="works-subtitle">
            Selecciona cada obra para explorar las notas al programa histórico, retos de digitación y especificaciones de grabación.
          </p>
        </div>

        <div class="works-grid">
          {works.map((work) => (
            <PerformanceCard work={work} />
          ))}
        </div>
      </div>

      <!-- Principios Artísticos y Técnicos -->
      <div class="disciplines-section glass-panel">
        <div class="disciplines-header">
          <span class="badge badge-media">Intersección Técnica & Artística</span>
          <h3>La Conexión entre Música Clásica e Ingeniería</h3>
        </div>

        <div class="disciplines-grid">
          {disciplines.map((d) => (
            <div class="discipline-card">
              <div class="d-dot"></div>
              <div>
                <h4 class="d-title">{d.title}</h4>
                <p class="d-desc">{d.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .multimedia-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .multimedia-hero {
    max-width: 820px;
    margin-bottom: var(--space-12);
  }

  .multimedia-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .multimedia-intro {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .studio-specs-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .studio-specs-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .spec-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .s-val {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .s-gold {
    color: var(--accent-media);
  }

  .s-lbl {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  /* Works Section */
  .works-section {
    margin-bottom: var(--space-16);
  }

  .works-header {
    margin-bottom: var(--space-8);
  }

  .works-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .works-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .works-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Disciplines Section */
  .disciplines-section {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }

  .disciplines-header {
    margin-bottom: var(--space-6);
  }

  .disciplines-header h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }

  .disciplines-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .disciplines-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .discipline-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .d-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-media);
    box-shadow: 0 0 8px var(--accent-media);
    flex-shrink: 0;
    margin-top: 6px;
  }

  .d-title {
    font-size: var(--text-base);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .d-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
