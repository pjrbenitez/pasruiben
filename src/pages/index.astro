---
// Initial placeholder for Setup verification (Tarea 1)
const title = "Portfolio & CV Dinámico | Jose M. Castillo";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      :root {
        --bg-color: #0b0f19;
        --text-color: #f3f4f6;
        --accent-color: #38bdf8;
        --border-color: #1f2937;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }
      body {
        margin: 0;
        padding: 2rem;
        background-color: var(--bg-color);
        color: var(--text-color);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        box-sizing: border-box;
      }
      .card {
        background: #111827;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 2.5rem;
        max-width: 600px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
      }
      h1 {
        font-size: 1.875rem;
        margin-top: 0;
        color: #ffffff;
      }
      .badge {
        display: inline-block;
        background: rgba(56, 189, 248, 0.1);
        color: var(--accent-color);
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 1rem;
        border: 1px solid rgba(56, 189, 248, 0.2);
      }
      p {
        line-height: 1.6;
        color: #9ca3af;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <div class="badge">Astro 5 + TypeScript + React</div>
      <h1>Jose M. Castillo</h1>
      <p>
        Portfolio interactivo & CV Dinámico orientado a <strong>Backend & Infraestructura Cloud</strong>, 
        <strong>Algoritmia y Trading Cuantitativo</strong>, <strong>Desarrollo en Godot</strong> y <strong>Multimedia</strong>.
      </p>
      <p style="font-size: 0.9rem; color: #6b7280; margin-bottom: 0;">
        Setup del repositorio verificado correctamente (Tarea 1 SDD).
      </p>
    </main>
  </body>
</html>
