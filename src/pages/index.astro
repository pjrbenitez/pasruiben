---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../utils/paths';

const pillars = [
  {
    title: 'Backend & Cloud-Native',
    badge: 'Pilar 1',
    badgeClass: 'badge-backend',
    gradientClass: 'gradient-text-backend',
    desc: 'Arquitecturas de microservicios resilientes, Spring Cloud, Apache Kafka, Kubernetes y GitOps con ArgoCD.',
    tech: ['Java 21', 'Spring Boot 3', 'Kubernetes', 'ArgoCD', 'Kafka'],
    href: '/backend',
  },
  {
    title: 'Algoritmia & Trading',
    badge: 'Pilar 2',
    badgeClass: 'badge-trading',
    gradientClass: 'gradient-text-trading',
    desc: 'Expert Advisors en MQL4/MQL5 y pipelines cuantitativos en Python con control estricto de drawdown y riesgo.',
    tech: ['MQL5', 'Python', 'Backtesting', 'Risk Management'],
    href: '/trading',
  },
  {
    title: 'Desarrollo & Godot',
    badge: 'Pilar 3',
    badgeClass: 'badge-gamedev',
    gradientClass: 'gradient-text-gamedev',
    desc: 'Simulación interactiva, diseño de mecánicas y optimización de físicas en Godot Engine con WebAssembly.',
    tech: ['Godot 4', 'GDScript / C#', 'Shaders', 'Wasm'],
    href: '/gamedev',
  },
  {
    title: 'Multimedia & Creatividad',
    badge: 'Pilar 4',
    badgeClass: 'badge-media',
    gradientClass: 'gradient-text-media',
    desc: 'Interpretaciones de piano clásico de alta exigencia técnica y edición/postproducción audiovisual profesional.',
    tech: ['Piano Clásico', 'Audio Lossless', 'Postproducción', 'Color Grading'],
    href: '/multimedia',
  },
];
---

<BaseLayout title="Pascual Ruiz Benítez | Tech Lead & Ingeniero de Software">
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="status-pulse"></span>
        <span>Tech Lead &bull; Cloud Architect &bull; Quantitative & Creative</span>
      </div>

      <h1 class="hero-title">
        Ingeniería de software de alto rendimiento, <span class="gradient-text-backend">arquitectura distribuida</span> y pensamiento algorítmico.
      </h1>

      <p class="hero-subtitle">
        Portfolio interactivo y CV dinámico de <strong>Pascual Ruiz Benítez</strong>.
        Diseñado para explorar proyectos reales en backend empresarial, modelos cuantitativos de trading, desarrollo en Godot y producción artística.
      </p>

      <div class="hero-cta">
        <a href={getUrl('/cv')} class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          Ver CV Dinámico
        </a>
        <a href={getUrl('/backend')} class="btn btn-outline">
          Explorar Proyectos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="pillars-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-backend">Especializaciones</span>
        <h2 class="section-title">Los Cuatro Pilares Técnicos</h2>
        <p class="section-desc">
          Profundidad de ingeniería en sistemas críticos combinada con solvencia matemática y versatilidad creativa.
        </p>
      </div>

      <div class="pillars-grid">
        {pillars.map((pillar) => (
          <article class="pillar-card glass-panel">
            <div class="pillar-top">
              <span class={`badge ${pillar.badgeClass}`}>{pillar.badge}</span>
              <a href={getUrl(pillar.href)} class="pillar-link-icon" aria-label={`Ver detalles de ${pillar.title}`}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            </div>

            <h3 class="pillar-title">
              <a href={getUrl(pillar.href)} class={pillar.gradientClass}>
                {pillar.title}
              </a>
            </h3>

            <p class="pillar-desc">{pillar.desc}</p>

            <ul class="pillar-tags">
              {pillar.tech.map((t) => (
                <li class="pillar-tag">{t}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.08) 0%, transparent 60%);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-backend);
    box-shadow: 0 0 8px var(--accent-backend);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .hero-title {
    font-size: clamp(2rem, 4vw + 1rem, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: var(--space-6);
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.2vw + 0.5rem, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .hero-subtitle strong {
    color: var(--color-text-primary);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .pillars-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-24);
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-12) auto;
  }

  .section-title {
    font-size: var(--text-3xl);
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pillars-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pillar-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .pillar-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-highlight);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
  }

  .pillar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .pillar-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--color-bg-elevated);
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .pillar-card:hover .pillar-link-icon {
    background: var(--accent-backend);
    color: #070b13;
  }

  .pillar-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .pillar-title a {
    text-decoration: none;
  }

  .pillar-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .pillar-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }

  .pillar-tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    background: var(--color-bg-surface);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border-subtle);
  }
</style>
