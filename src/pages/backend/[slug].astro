---
import { getCollection } from 'astro:content';
import BackendDetailView from '../../views/BackendDetailView.astro';

export async function getStaticPaths() {
  const projects = await getCollection('backend');
  const enProjects = projects.filter((p) => p.slug.startsWith('en/'));
  return enProjects.map((project) => ({
    params: { slug: project.slug.replace(/^en\//, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BackendDetailView project={project} locale="en" />
