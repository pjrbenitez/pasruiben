---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Backend & Cloud-Native | Pascual Ruiz Benítez">
  <div class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <span class="badge badge-backend">Pilar 1</span>
    <h1 style="margin-top: 1rem; margin-bottom: 1rem;">Backend & Infraestructura Cloud</h1>
    <p style="max-width: 650px; color: var(--color-text-secondary); margin-bottom: 2rem;">
      Especialización en arquitecturas distribuidas de alta concurrencia con Java, Spring Boot 3, Spring Cloud, Kafka, Kubernetes y GitOps con ArgoCD.
    </p>
    <div class="glass-panel" style="padding: 2rem; border-left: 4px solid var(--accent-backend);">
      <h3 style="margin-bottom: 0.5rem;">Arquitectura & Especificaciones</h3>
      <p style="color: var(--color-text-muted);">Esta sección se completará en profundidad durante la Tarea 4 del backlog.</p>
    </div>
  </div>
</BaseLayout>
