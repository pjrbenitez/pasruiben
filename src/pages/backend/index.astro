---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../../components/backend/ArchitectureDiagram.astro';
import BackendCard from '../../components/backend/BackendCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('backend');
projects.sort((a, b) => a.data.order - b.data.order);

const capabilities = [
  {
    area: 'Runtime & Lenguajes',
    items: ['Java 21 LTS (Records, Virtual Threads, Pattern Matching)', 'Spring Boot 3.x', 'TypeScript / Node.js'],
  },
  {
    area: 'Ecosistema Cloud & Orquestación',
    items: ['Kubernetes (EKS, Helm 3, RBAC, Ingress NGINX)', 'GitOps con ArgoCD & Argo Rollouts (Canary)', 'Docker'],
  },
  {
    area: 'Mensajería & Integración',
    items: ['Apache Kafka (Event-Driven Architecture, Outbox Pattern)', 'RESTful APIs con OpenAPI / Swagger', 'gRPC'],
  },
  {
    area: 'Resiliencia & Observabilidad',
    items: ['Resilience4j (Circuit Breakers, Bulkheads)', 'OpenTelemetry, Prometheus, Grafana, Micrometer Tracing'],
  },
  {
    area: 'Almacenamiento & Caché',
    items: ['PostgreSQL (Tuning, Particionamiento)', 'Redis (Caché distribuida, Redlock)', 'Liquibase / Flyway'],
  },
];
---

<BaseLayout
  title="Backend & Infraestructura Cloud-Native | Pascual Ruiz Benítez"
  description="Casos de estudio y especificaciones técnicas en arquitecturas distribuidas con Java 21, Spring Cloud, Kubernetes, ArgoCD GitOps y Apache Kafka."
>
  <div class="backend-page">
    <div class="container">
      <!-- Section Header -->
      <div class="backend-hero">
        <div class="badge badge-backend">Pilar 1 &bull; Core Engineering</div>
        <h1 class="backend-title">
          Backend Empresarial, <span class="gradient-text-backend">Infraestructura Cloud-Native</span> y GitOps
        </h1>
        <p class="backend-intro">
          Especialización en el diseño, desarrollo y liderazgo técnico de arquitecturas de software distribuidas de misión crítica. Enfoque riguroso en resiliencia, escalabilidad horizontal, despliegues continuos automatizados y observabilidad de extremo a extremo.
        </p>

        <!-- Quick Summary Bar -->
        <div class="quick-stack-bar glass-panel">
          <div class="qs-item">
            <span class="qs-label">LENGUAJE CORE</span>
            <span class="qs-val">Java 21 LTS</span>
          </div>
          <div class="qs-item">
            <span class="qs-label">FRAMEWORK</span>
            <span class="qs-val">Spring Boot 3 / Cloud</span>
          </div>
          <div class="qs-item">
            <span class="qs-label">ORQUESTACIÓN</span>
            <span class="qs-val">Kubernetes</span>
          </div>
          <div class="qs-item">
            <span class="qs-label">GITOPS</span>
            <span class="qs-val">ArgoCD</span>
          </div>
          <div class="qs-item">
            <span class="qs-label">EVENT STREAMING</span>
            <span class="qs-val">Apache Kafka</span>
          </div>
        </div>
      </div>

      <!-- Diagrama de Arquitectura Topológico Interactivo -->
      <ArchitectureDiagram />

      <!-- Casos de Estudio Proyectos -->
      <div class="case-studies-section">
        <div class="cases-header">
          <div>
            <span class="badge badge-backend">Casos de Estudio</span>
            <h2 class="cases-title">Arquitecturas Implementadas</h2>
          </div>
          <p class="cases-subtitle">
            Análisis detallado de decisiones de diseño, patrones de resiliencia y métricas de impacto real en producción.
          </p>
        </div>

        <div class="cards-grid">
          {projects.map((project) => (
            <BackendCard project={project} />
          ))}
        </div>
      </div>

      <!-- Matriz de Capacidades Técnicas -->
      <div class="capabilities-section glass-panel">
        <div class="capabilities-header">
          <span class="badge badge-backend">Competencias Técnicas</span>
          <h3>Matriz de Dominio en Backend e Infraestructura</h3>
        </div>

        <div class="capabilities-grid">
          {capabilities.map((c) => (
            <div class="cap-column">
              <h4 class="cap-title">{c.area}</h4>
              <ul class="cap-list">
                {c.items.map((it) => (
                  <li>
                    <span class="cap-bullet">&bull;</span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .backend-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .backend-hero {
    max-width: 820px;
    margin-bottom: var(--space-12);
  }

  .backend-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .backend-intro {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .quick-stack-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .quick-stack-bar {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .qs-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .qs-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .qs-val {
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  /* Case Studies */
  .case-studies-section {
    margin-bottom: var(--space-16);
  }

  .cases-header {
    margin-bottom: var(--space-8);
  }

  .cases-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .cases-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cards-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Capabilities Section */
  .capabilities-section {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }

  .capabilities-header {
    margin-bottom: var(--space-6);
  }

  .capabilities-header h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .capabilities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cap-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cap-title {
    font-size: var(--text-sm);
    color: var(--accent-backend);
    font-family: var(--font-display);
    font-weight: 700;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-2);
  }

  .cap-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cap-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .cap-bullet {
    color: var(--accent-backend);
    font-weight: bold;
  }
</style>
