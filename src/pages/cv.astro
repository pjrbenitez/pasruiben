---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Curriculum Vitae Dinámico | Pascual Ruiz Benítez">
  <div class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <span class="badge badge-backend">CV Dinámico</span>
    <h1 style="margin-top: 1rem; margin-bottom: 1rem;">Curriculum Vitae</h1>
    <p style="max-width: 650px; color: var(--color-text-secondary); margin-bottom: 2rem;">
      Trayectoria profesional, roles como Tech Lead, stack tecnológico empresarial y formación técnica continua.
    </p>
    <div class="glass-panel" style="padding: 2rem; border-left: 4px solid var(--accent-backend);">
      <h3 style="margin-bottom: 0.5rem;">Timeline Interactivo & Filtros</h3>
      <p style="color: var(--color-text-muted);">Esta sección se completará en profundidad durante la Tarea 8 del backlog.</p>
    </div>
  </div>
</BaseLayout>
