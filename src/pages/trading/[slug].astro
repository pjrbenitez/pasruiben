---
import { getCollection } from 'astro:content';
import TradingDetailView from '../../views/TradingDetailView.astro';

export async function getStaticPaths() {
  const strategies = await getCollection('trading');
  const enStrategies = strategies.filter((s) => s.slug.startsWith('en/'));
  return enStrategies.map((strategy) => ({
    params: { slug: strategy.slug.replace(/^en\//, '') },
    props: { strategy },
  }));
}

const { strategy } = Astro.props;
---

<TradingDetailView strategy={strategy} locale="en" />
