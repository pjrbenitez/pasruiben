---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Algoritmia & Trading Cuantitativo | Pascual Ruiz Benítez">
  <div class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <span class="badge badge-trading">Pilar 2</span>
    <h1 style="margin-top: 1rem; margin-bottom: 1rem;">Algoritmia & Trading Cuantitativo</h1>
    <p style="max-width: 650px; color: var(--color-text-secondary); margin-bottom: 2rem;">
      Diseño, validación estadística y ejecución de Expert Advisors (MQL4/MQL5) y modelos cuantitativos en Python con control estricto de riesgo.
    </p>
    <div class="glass-panel" style="padding: 2rem; border-left: 4px solid var(--accent-trading);">
      <h3 style="margin-bottom: 0.5rem;">Estrategias & Backtesting Auditado</h3>
      <p style="color: var(--color-text-muted);">Esta sección se completará en profundidad durante la Tarea 5 del backlog.</p>
    </div>
  </div>
</BaseLayout>
