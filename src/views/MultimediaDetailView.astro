---
import BaseLayout from '../layouts/BaseLayout.astro';
import AudioPlayer from '../components/multimedia/AudioPlayer.astro';
import { getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/languages';

interface Props {
  work: any;
  locale: Locale;
}

const { work, locale } = Astro.props;
const { data } = work;
const { Content } = await work.render();

const isEn = locale === 'en';
const backText = isEn ? 'Back to Multimedia Auditorium' : 'Volver al Auditorio Multimedia';
const composerPrefix = isEn ? 'Composer: ' : 'Compositor: ';
const durationPrefix = isEn ? 'Duration: ' : 'Duración: ';
const bitDepthLabel = isEn ? 'Bit Depth' : 'Profundidad de Bits';
const micLabel = isEn ? 'Microphone Setup' : 'Configuración de Microfonía';
const dawLabel = isEn ? 'DAW & Preamps Rig' : 'Cadena DAW / Preamps';
const historyTitle = isEn ? 'Historical Composition Context' : 'Contexto Histórico de la Composición';
const footerHeading = isEn ? 'Interested in acoustic audio production or video post-production?' : '¿Te interesa colaborar en producciones de audio acústico o vídeo?';
const footerDesc = isEn
  ? 'Available for acoustic microphony consultation, multitrack audio sync, or DaVinci Resolve color grading.'
  : 'Disponible para consultas sobre capturas de audio clásico, sincronización multipista o etalonaje en DaVinci Resolve.';
const contactBtn = isEn ? 'Contact' : 'Contactar';
const otherBtn = isEn ? 'View Other Performances' : 'Ver Otras Obras';
---

<BaseLayout
  title={`${data.title} | Pascual Ruiz Benítez`}
  description={data.description}
  locale={locale}
>
  <article class="work-detail-page">
    <div class="container work-container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/multimedia', locale)} class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>{backText}</span>
        </a>
      </nav>

      <!-- Work Header -->
      <header class="detail-header">
        <div class="detail-meta">
          <span class="badge badge-media">{data.category}</span>
          {data.composer && <span class="meta-tag">{composerPrefix}{data.composer}</span>}
          {data.opus && <span class="meta-tag">{data.opus}</span>}
          <span class="meta-tag">{durationPrefix}{data.duration}</span>
        </div>

        <h1 class="detail-title">{data.title}</h1>
        <p class="detail-lead">{data.description}</p>

        <!-- Ficha de Cadena de Grabación & Audio -->
        <div class="specs-panel glass-panel">
          <div class="spec-item">
            <span class="spec-val spec-gold">{data.recordingSpecs.sampleRate}</span>
            <span class="spec-lbl">Sample Rate</span>
          </div>
          <div class="spec-item">
            <span class="spec-val">{data.recordingSpecs.bitDepth}</span>
            <span class="spec-lbl">{bitDepthLabel}</span>
          </div>
          <div class="spec-item spec-wide">
            <span class="spec-val spec-small">{data.recordingSpecs.microphones}</span>
            <span class="spec-lbl">{micLabel}</span>
          </div>
          <div class="spec-item">
            <span class="spec-val spec-small">{data.recordingSpecs.dawsAndTools}</span>
            <span class="spec-lbl">{dawLabel}</span>
          </div>
        </div>

        <!-- Contexto Histórico -->
        <div class="history-card glass-panel">
          <h4 class="history-title">{historyTitle}</h4>
          <p class="history-text">{data.historicalContext}</p>
        </div>
      </header>

      <!-- Reproductor de Audio Integrado -->
      <AudioPlayer
        title={data.title}
        composer={data.composer || 'Pascual Ruiz Benítez'}
        duration={data.duration}
        waveform={data.waveformBars}
        category={data.category}
        locale={locale}
      />

      <!-- Notas al Programa Markdown -->
      <div class="program-notes-content markdown-body">
        <Content />
      </div>

      <!-- Footer de Contacto -->
      <footer class="detail-footer glass-panel">
        <div class="footer-copy">
          <h4>{footerHeading}</h4>
          <p>{footerDesc}</p>
        </div>
        <div class="footer-buttons">
          <a href="mailto:pascualjavier.ruiz@policia.es" class="btn btn-primary">
            {contactBtn}
          </a>
          <a href={getLocalizedPath('/multimedia', locale)} class="btn btn-outline">
            {otherBtn}
          </a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .work-detail-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .work-container {
    max-width: 860px;
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--accent-media);
    font-weight: 500;
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .back-link:hover {
    gap: var(--space-3);
    color: #ffffff;
  }

  .detail-header {
    margin-bottom: var(--space-12);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .detail-title {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .detail-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .specs-panel {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border-default);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .specs-panel {
      grid-template-columns: 1fr 1fr 1.5fr 1.5fr;
    }
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-val {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .spec-gold {
    color: var(--accent-media);
  }

  .spec-small {
    font-size: 11px;
  }

  .spec-lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .history-card {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
    background: rgba(7, 11, 19, 0.5);
  }

  .history-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .history-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .program-notes-content {
    line-height: 1.75;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-16);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-8);
  }

  .program-notes-content :global(h2) {
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-2);
  }

  .program-notes-content :global(h3) {
    font-size: var(--text-lg);
    color: var(--accent-media);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .program-notes-content :global(p) {
    margin-bottom: var(--space-4);
  }

  .program-notes-content :global(ul) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .program-notes-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .program-notes-content :global(strong) {
    color: var(--color-text-primary);
  }

  .detail-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .detail-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-copy h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .footer-copy p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
