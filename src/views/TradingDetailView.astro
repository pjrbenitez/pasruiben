---
import BaseLayout from '../layouts/BaseLayout.astro';
import EquityChart from '../components/trading/EquityChart.astro';
import { getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/languages';

interface Props {
  strategy: any;
  locale: Locale;
}

const { strategy, locale } = Astro.props;
const { data } = strategy;
const { Content } = await strategy.render();

const isEn = locale === 'en';
const backText = isEn ? 'Back to Algorithmic & Quantitative Trading' : 'Volver a Algoritmia & Trading Cuantitativo';
const riskTitle = isEn ? 'Risk Management Protocol' : 'Protocolo de Gestión de Riesgo';
const chartTitle = isEn ? `Simulated Equity Curve: ${data.title}` : `Curva de Equidad Simulada: ${data.title}`;
const footerHeading = isEn ? 'Interested in this algorithmic model or quantitative research?' : '¿Te interesa este modelo algorítmico o consultoría cuantitativa?';
const footerDesc = isEn
  ? 'Open to discussing risk budgeting, Monte Carlo stress validation, or MQL5/Python deployment.'
  : 'Disponible para discutir optimización de parámetros, análisis de robustez por Monte Carlo o implementación en MQL5.';
const contactBtn = isEn ? 'Contact about this Strategy' : 'Contactar sobre esta Estrategia';
const otherBtn = isEn ? 'View Other Systems' : 'Ver Otros Modelos';
---

<BaseLayout
  title={`${data.title} | Pascual Ruiz Benítez`}
  description={data.description}
  locale={locale}
>
  <article class="strategy-detail-page">
    <div class="container strategy-container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/trading', locale)} class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>{backText}</span>
        </a>
      </nav>

      <!-- Strategy Header -->
      <header class="detail-header">
        <div class="detail-meta">
          <span class="badge badge-trading">{data.strategyType}</span>
          <span class="meta-tag">{data.platform}</span>
          <span class="meta-tag">Timeframe: {data.timeframe}</span>
        </div>

        <h1 class="detail-title">{data.title}</h1>
        <p class="detail-lead">{data.description}</p>

        <!-- Panel de Métricas Cuantitativas Completas -->
        <div class="stats-panel glass-panel">
          <div class="stat-box">
            <span class="stat-num stat-green">{data.metrics.profitFactor.toFixed(2)}</span>
            <span class="stat-name">Profit Factor</span>
          </div>
          <div class="stat-box">
            <span class="stat-num stat-green">{data.metrics.sharpeRatio.toFixed(2)}</span>
            <span class="stat-name">Sharpe Ratio</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">{data.metrics.sortinoRatio.toFixed(2)}</span>
            <span class="stat-name">Sortino Ratio</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">{data.metrics.maxDrawdown}</span>
            <span class="stat-name">Max Drawdown</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">{data.metrics.winRate}</span>
            <span class="stat-name">Win Rate</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">{data.metrics.totalTrades.toLocaleString()}</span>
            <span class="stat-name">Total Trades</span>
          </div>
        </div>

        <!-- Reglas de Gestión de Riesgo Destacadas -->
        <div class="risk-rules-box glass-panel">
          <h4 class="risk-rules-title">{riskTitle}</h4>
          <ul class="risk-rules-list">
            {data.riskManagement.map((rule: string) => (
              <li>
                <svg class="r-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{rule}</span>
              </li>
            ))}
          </ul>
        </div>
      </header>

      <!-- Gráfico de Curva de Equidad -->
      {data.equityCurve && data.equityCurve.length > 0 && (
        <EquityChart data={data.equityCurve} title={chartTitle} locale={locale} />
      )}

      <!-- Contenido del Artículo Markdown -->
      <div class="strategy-content markdown-body">
        <Content />
      </div>

      <!-- Footer de Contacto -->
      <footer class="detail-footer glass-panel">
        <div class="footer-copy">
          <h4>{footerHeading}</h4>
          <p>{footerDesc}</p>
        </div>
        <div class="footer-buttons">
          <a href="mailto:pascualjavier.ruiz@policia.es" class="btn btn-primary">
            {contactBtn}
          </a>
          <a href={getLocalizedPath('/trading', locale)} class="btn btn-outline">
            {otherBtn}
          </a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .strategy-detail-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .strategy-container {
    max-width: 860px;
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--accent-trading);
    font-weight: 500;
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .back-link:hover {
    gap: var(--space-3);
    color: #ffffff;
  }

  .detail-header {
    margin-bottom: var(--space-12);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .detail-title {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .detail-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .stats-panel {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border-default);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .stats-panel {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 800px) {
    .stats-panel {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .stat-green {
    color: var(--accent-trading);
  }

  .stat-name {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .risk-rules-box {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
    background: rgba(7, 11, 19, 0.5);
  }

  .risk-rules-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .risk-rules-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .risk-rules-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .r-check {
    color: var(--accent-trading);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .strategy-content {
    line-height: 1.75;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-16);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-8);
  }

  .strategy-content :global(h2) {
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-2);
  }

  .strategy-content :global(h3) {
    font-size: var(--text-lg);
    color: var(--accent-trading);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .strategy-content :global(p) {
    margin-bottom: var(--space-4);
  }

  .strategy-content :global(ul) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .strategy-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .strategy-content :global(strong) {
    color: var(--color-text-primary);
  }

  .detail-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .detail-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-copy h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .footer-copy p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
