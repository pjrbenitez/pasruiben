---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/gamedev/GameCard.astro';
import { getCollection } from 'astro:content';
import { HUBS_TRANSLATIONS } from '../i18n/hubs';
import type { Locale } from '../i18n/languages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = HUBS_TRANSLATIONS[locale].gamedev;

// Fetch collection filtered by locale
const allProjects = await getCollection('gamedev');
const projects = allProjects
  .filter((p) => p.slug.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order);

const pageTitle = locale === 'en'
  ? 'Godot Engine, Simulation & GameDev | Pascual Ruiz Benítez'
  : 'Desarrollo en Godot, Simulación & GameDev | Pascual Ruiz Benítez';

const pageDesc = locale === 'en'
  ? 'Interactive gameplay prototypes, physics simulations, and WebAssembly browser exports developed in Godot Engine 4 (GDScript/C#).'
  : 'Prototipos interactivos, simulaciones físicas y compilaciones a WebAssembly en Godot Engine 4 (GDScript/C#).';
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale}>
  <div class="gamedev-page">
    <div class="container">
      <!-- Section Header -->
      <div class="gamedev-hero">
        <div class="badge badge-gamedev">{t.heroBadge}</div>
        <h1 class="gamedev-title">
          {t.title}<span class="gradient-text-gamedev">{t.titleHighlight}</span>
        </h1>
        <p class="gamedev-intro">{t.intro}</p>

        <!-- Quick Specs Bar -->
        <div class="quick-specs-bar glass-panel">
          {t.quickSpecs.map((item) => (
            <div class="qs-item">
              <span class="qs-label">{item.label}</span>
              <span class="qs-val">{item.val}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Proyectos de Juego & Simulaciones -->
      <div class="games-section">
        <div class="games-header">
          <div>
            <span class="badge badge-gamedev">{t.gamesBadge}</span>
            <h2 class="games-title">{t.gamesTitle}</h2>
          </div>
          <p class="games-subtitle">{t.gamesSubtitle}</p>
        </div>

        <div class="games-grid">
          {projects.map((project) => (
            <GameCard project={project} locale={locale} />
          ))}
        </div>
      </div>

      <!-- Patrones y Técnicas de Arquitectura -->
      <div class="patterns-section glass-panel">
        <div class="patterns-header">
          <span class="badge badge-gamedev">{t.patternsBadge}</span>
          <h3>{t.patternsTitle}</h3>
        </div>

        <div class="patterns-grid">
          {t.patterns.map((item) => (
            <div class="pattern-item">
              <div class="pattern-title-row">
                <svg class="pattern-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
                <h4>{item.pattern}</h4>
              </div>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .gamedev-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .gamedev-hero {
    max-width: 820px;
    margin-bottom: var(--space-12);
  }

  .gamedev-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .gamedev-intro {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .quick-specs-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .quick-specs-bar {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .qs-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .qs-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .qs-val {
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .games-section {
    margin-bottom: var(--space-16);
  }

  .games-header {
    margin-bottom: var(--space-8);
  }

  .games-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .games-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .games-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .patterns-section {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }

  .patterns-header {
    margin-bottom: var(--space-6);
  }

  .patterns-header h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }

  .patterns-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .patterns-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pattern-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pattern-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .pattern-icon {
    color: var(--accent-gamedev);
    flex-shrink: 0;
  }

  .pattern-title-row h4 {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .pattern-item p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
