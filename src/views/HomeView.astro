---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalHud from '../components/home/TerminalHud.astro';
import StatsBar from '../components/home/StatsBar.astro';
import PillarsGrid from '../components/home/PillarsGrid.astro';
import SpotlightProjects from '../components/home/SpotlightProjects.astro';
import CtaBanner from '../components/home/CtaBanner.astro';
import { getLocalizedPath } from '../i18n/utils';
import { HOME_TRANSLATIONS } from '../i18n/home';
import type { Locale } from '../i18n/languages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = HOME_TRANSLATIONS[locale].hero;
---

<BaseLayout locale={locale}>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <!-- Left Column: Copy & CTAs -->
      <div class="hero-left">
        <div class="hero-badge">
          <span class="status-pulse"></span>
          <span>{t.badge}</span>
        </div>

        <h1 class="hero-title">
          {t.titleStart}<span class="gradient-text-backend">{t.titleHighlight}</span>{t.titleEnd}
        </h1>

        <p class="hero-subtitle">
          {t.subtitlePrefix}<strong>{t.subtitleName}</strong>{t.subtitleSuffix}
        </p>

        <div class="hero-cta-group">
          <a href={getLocalizedPath('/cv', locale)} class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            {t.cvBtn}
          </a>

          <a href="#especializaciones" class="btn btn-outline">
            <span>{t.pillarsBtn}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Terminal HUD -->
      <div class="hero-right">
        <TerminalHud locale={locale} />
      </div>
    </div>
  </section>

  <!-- Key Metrics & SLA Bar -->
  <StatsBar locale={locale} />

  <!-- The 4 Pillars Deep Showcase -->
  <PillarsGrid locale={locale} />

  <!-- Featured Projects Spotlight -->
  <SpotlightProjects locale={locale} />

  <!-- Final Call to Action -->
  <CtaBanner locale={locale} />
</BaseLayout>

<style>
  .hero-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    background: radial-gradient(circle at 40% 10%, rgba(56, 189, 248, 0.08) 0%, transparent 65%);
    border-bottom: 1px solid var(--color-border-subtle);
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 980px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  .hero-title {
    font-size: clamp(2.2rem, 4vw + 0.5rem, 3.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.2vw + 0.5rem, 1.2rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 620px;
    margin-bottom: var(--space-8);
  }

  .hero-subtitle strong {
    color: var(--color-text-primary);
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .hero-right {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
</style>
