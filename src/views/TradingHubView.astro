---
import BaseLayout from '../layouts/BaseLayout.astro';
import StrategyCard from '../components/trading/StrategyCard.astro';
import EquityChart from '../components/trading/EquityChart.astro';
import { getCollection } from 'astro:content';
import { HUBS_TRANSLATIONS } from '../i18n/hubs';
import type { Locale } from '../i18n/languages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = HUBS_TRANSLATIONS[locale].trading;

// Fetch collection filtered by locale
const allStrategies = await getCollection('trading');
const strategies = allStrategies
  .filter((s) => s.slug.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order);

// Curva agregada para el gráfico principal
const aggregateCurve = [10000, 10300, 10550, 10420, 10890, 11400, 11250, 11800, 12450, 12900, 13400, 13150, 13900, 14600, 15200, 15800, 16400, 16950, 17500, 18200, 18900, 19650, 20400, 21200, 21950, 22800, 23550, 24600, 25800, 27400];

const pageTitle = locale === 'en'
  ? 'Algorithmic & Quantitative Trading | Pascual Ruiz Benítez'
  : 'Algoritmia & Trading Cuantitativo | Pascual Ruiz Benítez';

const pageDesc = locale === 'en'
  ? 'Development of automated Expert Advisors (MQL4/MQL5), statistical Python models, and audited quantitative backtesting under strict drawdown limits.'
  : 'Desarrollo de Expert Advisors (MQL4/MQL5), modelos estadísticos en Python y backtesting cuantitativo auditado con estricto control de riesgo.';

const chartTitle = locale === 'en'
  ? 'Aggregate Equity Curve of Quantitative Models (Normalized to $10,000)'
  : 'Curva de Equidad Agregada de Modelos Cuantitativos (Base $10,000)';
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale}>
  <div class="trading-page">
    <div class="container">
      <!-- Section Header -->
      <div class="trading-hero">
        <div class="badge badge-trading">{t.heroBadge}</div>
        <h1 class="trading-title">
          {t.title}<span class="gradient-text-trading">{t.titleHighlight}</span>
        </h1>
        <p class="trading-intro">{t.intro}</p>

        <!-- Global Metrics Bar -->
        <div class="global-metrics-strip glass-panel">
          {t.quickMetrics.map((item) => (
            <div class="gm-box">
              <span class="gm-val">{item.val}</span>
              <span class="gm-lbl">{item.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Curva de Equidad Agregada -->
      <EquityChart data={aggregateCurve} title={chartTitle} locale={locale} />

      <!-- Estrategias y Modelos -->
      <div class="strategies-section">
        <div class="strategies-header">
          <div>
            <span class="badge badge-trading">{t.strategiesBadge}</span>
            <h2 class="strategies-title">{t.strategiesTitle}</h2>
          </div>
          <p class="strategies-subtitle">{t.strategiesSubtitle}</p>
        </div>

        <div class="strategies-grid">
          {strategies.map((strategy) => (
            <StrategyCard strategy={strategy} locale={locale} />
          ))}
        </div>
      </div>

      <!-- Principios de Gestión Cuantitativa -->
      <div class="principles-section glass-panel">
        <div class="principles-header">
          <span class="badge badge-trading">{t.riskBadge}</span>
          <h3>{t.riskTitle}</h3>
        </div>

        <div class="principles-grid">
          {t.riskRules.map((p) => (
            <div class="principle-card">
              <div class="p-header">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="p-icon">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <h4 class="p-title">{p.rule}</h4>
              </div>
              <p class="p-desc">{p.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .trading-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .trading-hero {
    max-width: 820px;
    margin-bottom: var(--space-12);
  }

  .trading-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .trading-intro {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .global-metrics-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .global-metrics-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gm-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .gm-val {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--accent-trading);
  }

  .gm-lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .strategies-section {
    margin-bottom: var(--space-16);
  }

  .strategies-header {
    margin-bottom: var(--space-8);
  }

  .strategies-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .strategies-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .strategies-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .principles-section {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }

  .principles-header {
    margin-bottom: var(--space-6);
  }

  .principles-header h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .principle-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .p-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .p-icon {
    color: var(--accent-trading);
    flex-shrink: 0;
  }

  .p-title {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .p-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
