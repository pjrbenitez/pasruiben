---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/languages';

interface Props {
  project: any;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const isEn = locale === 'en';
const backText = isEn ? 'Back to Backend & Cloud Hub' : 'Volver al Hub de Backend & Cloud';
const rolePrefix = isEn ? 'Role: ' : 'Rol: ';
const stackTitle = isEn ? 'Tech Stack:' : 'Stack Tecnológico:';
const footerHeading = isEn ? 'Interested in this architectural pattern?' : '¿Te interesa este patrón de arquitectura?';
const footerDesc = isEn
  ? 'We can discuss implementation details, scalability guarantees, or tailoring it to your platform.'
  : 'Podemos discutir detalles de implementación, escalabilidad o adaptación a tu plataforma.';
const contactBtn = isEn ? 'Discuss this Project' : 'Contactar sobre este Proyecto';
const otherBtn = isEn ? 'View Other Cases' : 'Ver Otros Casos';
---

<BaseLayout
  title={`${data.title} | Pascual Ruiz Benítez`}
  description={data.description}
  locale={locale}
>
  <article class="case-study-page">
    <div class="container case-container">
      <!-- Breadcrumb & Back Link -->
      <nav class="case-breadcrumb" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/backend', locale)} class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>{backText}</span>
        </a>
      </nav>

      <!-- Case Study Header -->
      <header class="case-header">
        <div class="header-meta">
          <span class="badge badge-backend">{data.category}</span>
          <span class="arch-badge">{data.architectureType}</span>
          <span class="role-badge">{rolePrefix}{data.role}</span>
        </div>

        <h1 class="case-title">{data.title}</h1>
        <p class="case-lead">{data.description}</p>

        <!-- Métricas Principales -->
        <div class="metrics-grid glass-panel">
          {data.metrics.map((m: any) => (
            <div class="metric-item">
              <span class="metric-val">{m.value}</span>
              <span class="metric-lbl">{m.label}</span>
            </div>
          ))}
        </div>

        <!-- Tecnologías Utilizadas -->
        <div class="tech-stack-row">
          <span class="tech-row-title">{stackTitle}</span>
          <div class="tech-row-pills">
            {data.technologies.map((t: string) => (
              <span class="tech-pill">{t}</span>
            ))}
          </div>
        </div>
      </header>

      <!-- Contenido del Artículo Markdown -->
      <div class="case-content markdown-body">
        <Content />
      </div>

      <!-- Footer del Caso de Estudio -->
      <footer class="case-footer glass-panel">
        <div class="footer-left">
          <h4>{footerHeading}</h4>
          <p>{footerDesc}</p>
        </div>
        <div class="footer-right">
          <a href="mailto:pascualjavier.ruiz@policia.es" class="btn btn-primary">
            {contactBtn}
          </a>
          <a href={getLocalizedPath('/backend', locale)} class="btn btn-outline">
            {otherBtn}
          </a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .case-container {
    max-width: 860px;
  }

  .case-breadcrumb {
    margin-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--accent-backend);
    font-weight: 500;
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .back-link:hover {
    gap: var(--space-3);
    color: #ffffff;
  }

  .case-header {
    margin-bottom: var(--space-12);
  }

  .header-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .arch-badge, .role-badge {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .case-title {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .case-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metric-val {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--accent-backend);
  }

  .metric-lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .tech-stack-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .tech-row-title {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .tech-row-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tech-pill {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    background: var(--color-bg-surface);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border-subtle);
  }

  .case-content {
    line-height: 1.75;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-16);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-8);
  }

  .case-content :global(h2) {
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-2);
  }

  .case-content :global(h3) {
    font-size: var(--text-lg);
    color: var(--accent-backend);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .case-content :global(p) {
    margin-bottom: var(--space-4);
  }

  .case-content :global(ul) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .case-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .case-content :global(strong) {
    color: var(--color-text-primary);
  }

  .case-content :global(hr) {
    border: 0;
    height: 1px;
    background: var(--color-border-subtle);
    margin: var(--space-8) 0;
  }

  .case-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .case-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-left h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .footer-left p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-right {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
