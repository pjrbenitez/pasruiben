---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../components/backend/ArchitectureDiagram.astro';
import BackendCard from '../components/backend/BackendCard.astro';
import { getCollection } from 'astro:content';
import { HUBS_TRANSLATIONS } from '../i18n/hubs';
import type { Locale } from '../i18n/languages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = HUBS_TRANSLATIONS[locale].backend;

// Fetch collection filtered by locale subfolder (en/ or es/)
const allProjects = await getCollection('backend');
const projects = allProjects
  .filter((p) => p.slug.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order);

const pageTitle = locale === 'en'
  ? 'Backend & Cloud-Native Infrastructure | Pascual Ruiz Benítez'
  : 'Backend & Infraestructura Cloud-Native | Pascual Ruiz Benítez';

const pageDesc = locale === 'en'
  ? 'Case studies and technical specifications in distributed architectures with Java 21, Spring Cloud, Kubernetes, ArgoCD GitOps, and Apache Kafka.'
  : 'Casos de estudio y especificaciones técnicas en arquitecturas distribuidas con Java 21, Spring Cloud, Kubernetes, ArgoCD GitOps y Apache Kafka.';
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale}>
  <div class="backend-page">
    <div class="container">
      <!-- Section Header -->
      <div class="backend-hero">
        <div class="badge badge-backend">{t.heroBadge}</div>
        <h1 class="backend-title">
          {t.title}<span class="gradient-text-backend">{t.titleHighlight}</span>
        </h1>
        <p class="backend-intro">{t.intro}</p>

        <!-- Quick Summary Bar -->
        <div class="quick-stack-bar glass-panel">
          {t.quickStack.map((item) => (
            <div class="qs-item">
              <span class="qs-label">{item.label}</span>
              <span class="qs-val">{item.val}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Diagrama de Arquitectura Topológico Interactivo -->
      <ArchitectureDiagram locale={locale} />

      <!-- Casos de Estudio Proyectos -->
      <div class="case-studies-section">
        <div class="cases-header">
          <div>
            <span class="badge badge-backend">{t.casesBadge}</span>
            <h2 class="cases-title">{t.casesTitle}</h2>
          </div>
          <p class="cases-subtitle">{t.casesSubtitle}</p>
        </div>

        <div class="cards-grid">
          {projects.map((project) => (
            <BackendCard project={project} locale={locale} />
          ))}
        </div>
      </div>

      <!-- Matriz de Capacidades Técnicas -->
      <div class="capabilities-section glass-panel">
        <div class="capabilities-header">
          <span class="badge badge-backend">{t.capabilitiesBadge}</span>
          <h3>{t.capabilitiesTitle}</h3>
        </div>

        <div class="capabilities-grid">
          {t.capabilities.map((c) => (
            <div class="cap-column">
              <h4 class="cap-title">{c.area}</h4>
              <ul class="cap-list">
                {c.items.map((it) => (
                  <li>
                    <span class="cap-bullet">&bull;</span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .backend-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .backend-hero {
    max-width: 820px;
    margin-bottom: var(--space-12);
  }

  .backend-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .backend-intro {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .quick-stack-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .quick-stack-bar {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .qs-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .qs-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .qs-val {
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .case-studies-section {
    margin-bottom: var(--space-16);
  }

  .cases-header {
    margin-bottom: var(--space-8);
  }

  .cases-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .cases-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cards-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .capabilities-section {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }

  .capabilities-header {
    margin-bottom: var(--space-6);
  }

  .capabilities-header h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .capabilities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cap-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cap-title {
    font-size: var(--text-sm);
    color: var(--accent-backend);
    font-family: var(--font-display);
    font-weight: 700;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-2);
  }

  .cap-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cap-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .cap-bullet {
    color: var(--accent-backend);
    font-weight: bold;
  }
</style>
