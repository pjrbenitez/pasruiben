---
import BaseLayout from '../layouts/BaseLayout.astro';
import WasmContainer from '../components/gamedev/WasmContainer.astro';
import { getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/languages';

interface Props {
  project: any;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const isEn = locale === 'en';
const backText = isEn ? 'Back to Godot Engine & GameDev Hub' : 'Volver al Hub de Desarrollo en Godot';
const playableTag = isEn ? 'Playable Demo' : 'Demo Jugable';
const patternsTitle = isEn ? 'Implemented Architecture & Patterns' : 'Arquitectura y Patrones Implementados';
const footerHeading = isEn ? 'Interested in this project architecture or collaborating on GameDev?' : '¿Te interesa la arquitectura de este proyecto o colaborar en gamedev?';
const footerDesc = isEn
  ? 'Available to discuss physics optimization, custom shaders, or game software architecture.'
  : 'Disponible para discutir optimización de físicas, shaders o patrones de software para juegos.';
const contactBtn = isEn ? 'Contact about GameDev' : 'Contactar sobre GameDev';
const otherBtn = isEn ? 'View Other Projects' : 'Ver Otros Proyectos';
---

<BaseLayout
  title={`${data.title} | Pascual Ruiz Benítez`}
  description={data.description}
  locale={locale}
>
  <article class="gamedev-detail-page">
    <div class="container gamedev-container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/gamedev', locale)} class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>{backText}</span>
        </a>
      </nav>

      <!-- Game Header -->
      <header class="detail-header">
        <div class="detail-meta">
          <span class="badge badge-gamedev">{data.genre}</span>
          <span class="engine-tag">{data.engineVersion}</span>
          {data.playable && <span class="playable-tag">{playableTag}</span>}
        </div>

        <h1 class="detail-title">{data.title}</h1>
        <p class="detail-lead">{data.description}</p>

        <!-- Panel de Rendimiento del Motor -->
        <div class="performance-panel glass-panel">
          <div class="perf-item">
            <span class="perf-val perf-purple">{data.metrics.targetFps}</span>
            <span class="perf-lbl">Target Performance</span>
          </div>
          <div class="perf-item">
            <span class="perf-val">{data.metrics.physicsTickRate}</span>
            <span class="perf-lbl">Physics Tick</span>
          </div>
          <div class="perf-item">
            <span class="perf-val">{data.metrics.drawCallsOptimized}</span>
            <span class="perf-lbl">Draw Calls</span>
          </div>
          <div class="perf-item">
            <span class="perf-val">{data.metrics.memoryFootprint}</span>
            <span class="perf-lbl">Memory Target</span>
          </div>
        </div>

        <!-- Patrones de Arquitectura -->
        <div class="patterns-highlight glass-panel">
          <h4 class="patterns-title">{patternsTitle}</h4>
          <ul class="patterns-grid">
            {data.architecturePatterns.map((pat: string) => (
              <li>
                <svg class="pat-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{pat}</span>
              </li>
            ))}
          </ul>
        </div>
      </header>

      <!-- Contenedor WebAssembly si es jugable -->
      {data.playable && (
        <WasmContainer title={data.title} locale={locale} />
      )}

      <!-- Contenido Técnico del Devlog -->
      <div class="devlog-content markdown-body">
        <Content />
      </div>

      <!-- Footer de Contacto -->
      <footer class="detail-footer glass-panel">
        <div class="footer-copy">
          <h4>{footerHeading}</h4>
          <p>{footerDesc}</p>
        </div>
        <div class="footer-buttons">
          <a href="mailto:pascualjavier.ruiz@policia.es" class="btn btn-primary">
            {contactBtn}
          </a>
          <a href={getLocalizedPath('/gamedev', locale)} class="btn btn-outline">
            {otherBtn}
          </a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .gamedev-detail-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-20);
  }

  .gamedev-container {
    max-width: 860px;
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--accent-gamedev);
    font-weight: 500;
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .back-link:hover {
    gap: var(--space-3);
    color: #ffffff;
  }

  .detail-header {
    margin-bottom: var(--space-12);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .engine-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .playable-tag {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--accent-gamedev);
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.25);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .detail-title {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .detail-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .performance-panel {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border-default);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .performance-panel {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .perf-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .perf-val {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .perf-purple {
    color: var(--accent-gamedev);
  }

  .perf-lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .patterns-highlight {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
    background: rgba(7, 11, 19, 0.5);
  }

  .patterns-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .patterns-grid {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .patterns-grid li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .pat-check {
    color: var(--accent-gamedev);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .devlog-content {
    line-height: 1.75;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-16);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-8);
  }

  .devlog-content :global(h2) {
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-2);
  }

  .devlog-content :global(h3) {
    font-size: var(--text-lg);
    color: var(--accent-gamedev);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .devlog-content :global(p) {
    margin-bottom: var(--space-4);
  }

  .devlog-content :global(ul) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .devlog-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .devlog-content :global(strong) {
    color: var(--color-text-primary);
  }

  .detail-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
  }

  @media (min-width: 768px) {
    .detail-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-copy h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .footer-copy p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
