---
import { getUrl } from '../../utils/paths';

interface Props {
  project: {
    slug: string;
    data: {
      title: string;
      description: string;
      category: string;
      architectureType: string;
      technologies: string[];
      metrics: { label: string; value: string }[];
      highlights: string[];
      featured: boolean;
    };
  };
}

const { project } = Astro.props;
const { slug, data } = project;
---

<article class="backend-card glass-panel">
  <div class="card-header">
    <div class="header-badges">
      <span class="badge badge-backend">{data.category}</span>
      <span class="arch-type">{data.architectureType}</span>
    </div>
    {data.featured && <span class="featured-badge">Featured Case</span>}
  </div>

  <h3 class="card-title">
    <a href={getUrl(`/backend/${slug}`)}>
      {data.title}
    </a>
  </h3>

  <p class="card-desc">{data.description}</p>

  <!-- Métricas Clave -->
  <div class="metrics-strip">
    {data.metrics.map((m) => (
      <div class="metric-box">
        <span class="m-val">{m.value}</span>
        <span class="m-label">{m.label}</span>
      </div>
    ))}
  </div>

  <!-- Highlights -->
  <div class="highlights-container">
    <h4 class="highlights-title">Aspectos Técnicos</h4>
    <ul class="highlights-list">
      {data.highlights.slice(0, 3).map((h) => (
        <li>
          <svg class="h-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{h}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Footer con Tecnologías y Enlace -->
  <div class="card-footer">
    <div class="tech-pills">
      {data.technologies.map((tech) => (
        <span class="tech-tag">{tech}</span>
      ))}
    </div>

    <a href={getUrl(`/backend/${slug}`)} class="btn-read-case">
      <span>Ver Caso Completo</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .backend-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    transition: all var(--transition-base);
  }

  .backend-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-highlight);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 24px rgba(56, 189, 248, 0.08);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .arch-type {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .featured-badge {
    font-size: 10px;
    font-family: var(--font-mono);
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .card-title {
    font-size: var(--text-xl);
    line-height: 1.3;
    margin-bottom: var(--space-3);
  }

  .card-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .card-title a:hover {
    color: var(--accent-backend);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    background: rgba(7, 11, 19, 0.6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .metrics-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m-val {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--accent-backend);
  }

  .m-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .highlights-container {
    margin-bottom: var(--space-6);
  }

  .highlights-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .h-icon {
    color: var(--accent-backend);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .card-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tech-tag {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    background: var(--color-bg-surface);
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border-subtle);
  }

  .btn-read-case {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent-backend);
    text-decoration: none;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--accent-backend-subtle);
    border: 1px solid rgba(56, 189, 248, 0.2);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .btn-read-case:hover {
    background: var(--accent-backend);
    color: #070b13;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.4);
  }
</style>
