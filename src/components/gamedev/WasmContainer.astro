---
import { getLocaleFromUrl } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  title?: string;
  gameSlug?: string;
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const {
  title = 'Chronicles of Aethelgard',
  locale = getLocaleFromUrl(pathname),
} = Astro.props;

const isEn = locale === 'en';
const texts = isEn
  ? {
      heading: 'WebAssembly Container Ready',
      desc: 'Optimized viewport configured for Godot 4 web exports. Supports single/multithreaded WebAssembly execution, WebGL 2.0 rendering, and low-latency WebAudio.',
      controls: '<span class="key-badge">W A S D</span> Movement &bull; <span class="key-badge">J</span> Attack &bull; <span class="key-badge">K</span> Dash &bull; <span class="key-badge">SPACE</span> Jump',
      footer: 'For fullscreen mode or native desktop builds (Windows / Linux), check the project repository links.',
    }
  : {
      heading: 'Embebido WebAssembly Listo',
      desc: 'Contenedor optimizado para cargar exportaciones web de Godot 4. Soporta ejecución en hilo de navegador con memoria compartida (SharedArrayBuffer) y audio estéreo WebAudio.',
      controls: '<span class="key-badge">W A S D</span> Movimiento &bull; <span class="key-badge">J</span> Ataque &bull; <span class="key-badge">K</span> Dash &bull; <span class="key-badge">ESPACIO</span> Salto',
      footer: 'Para jugar a pantalla completa o acceder a builds de escritorio nativos (Windows/Linux), consulta los enlaces del repositorio.',
    };
---

<div class="wasm-viewport glass-panel">
  <div class="viewport-bar">
    <div class="viewport-title">
      <span class="game-status-dot"></span>
      <span>Godot 4 WebAssembly Player &bull; {title}</span>
    </div>
    <div class="viewport-meta">
      <span class="wasm-pill">WebGL 2.0 / WebAssembly</span>
    </div>
  </div>

  <div class="canvas-container">
    <div class="placeholder-screen">
      <div class="screen-content">
        <div class="screen-logo">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <h4 class="screen-heading">{texts.heading}</h4>
        <p class="screen-desc">{texts.desc}</p>
        <div class="controls-hint" set:html={texts.controls} />
      </div>
    </div>
  </div>

  <div class="viewport-footer">
    <span>{texts.footer}</span>
  </div>
</div>

<style>
  .wasm-viewport {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-default);
    overflow: hidden;
    margin-bottom: var(--space-10);
  }

  .viewport-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: rgba(14, 20, 34, 0.95);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .viewport-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-primary);
  }

  .game-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-gamedev);
    box-shadow: 0 0 8px var(--accent-gamedev);
  }

  .wasm-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-gamedev);
    background: rgba(168, 85, 247, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(168, 85, 247, 0.2);
  }

  .canvas-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #050811;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-screen {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-6);
  }

  .screen-content {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .screen-logo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 24px rgba(168, 85, 247, 0.2);
  }

  .screen-heading {
    font-size: var(--text-lg);
    color: var(--color-text-primary);
  }

  .screen-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .controls-hint {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-secondary);
    background: rgba(14, 20, 34, 0.8);
    border: 1px solid var(--color-border-subtle);
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    margin-top: var(--space-2);
  }

  .controls-hint :global(.key-badge) {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--color-border-default);
    padding: 1px 5px;
    border-radius: var(--radius-xs);
    color: #ffffff;
    font-weight: 700;
  }

  .viewport-footer {
    padding: 8px 16px;
    background: rgba(14, 20, 34, 0.8);
    border-top: 1px solid var(--color-border-subtle);
    font-size: 11px;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
