---
interface Props {
  title?: string;
  gameSlug?: string;
}

const {
  title = "Chronicles of Aethelgard",
} = Astro.props;
---

<div class="wasm-viewport glass-panel">
  <div class="viewport-bar">
    <div class="viewport-title">
      <span class="game-status-dot"></span>
      <span>Godot 4 WebAssembly Player &bull; {title}</span>
    </div>
    <div class="viewport-meta">
      <span class="wasm-pill">WebGL 2.0 / WebAssembly</span>
    </div>
  </div>

  <div class="canvas-container">
    <div class="placeholder-screen">
      <div class="screen-content">
        <div class="screen-logo">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <h4 class="screen-heading">Embebido WebAssembly Listo</h4>
        <p class="screen-desc">
          Contenedor optimizado para cargar exportaciones web de Godot 4. Soporta ejecución en hilo de navegador con memoria compartida (SharedArrayBuffer) y audio estéreo WebAudio.
        </p>
        <div class="controls-hint">
          <span class="key-badge">W A S D</span> Movimiento &bull; <span class="key-badge">J</span> Ataque &bull; <span class="key-badge">K</span> Dash &bull; <span class="key-badge">ESPACIO</span> Salto
        </div>
      </div>
    </div>
  </div>

  <div class="viewport-footer">
    <span>Para jugar a pantalla completa o acceder a builds de escritorio nativos (Windows/Linux), consulta los enlaces del repositorio.</span>
  </div>
</div>

<style>
  .wasm-viewport {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-default);
    overflow: hidden;
    margin-bottom: var(--space-10);
  }

  .viewport-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: rgba(14, 20, 34, 0.95);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .viewport-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  .game-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #c084fc;
    box-shadow: 0 0 6px #c084fc;
  }

  .wasm-pill {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--accent-gamedev);
  }

  .canvas-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 440px;
    background: #03060c;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .placeholder-screen {
    padding: var(--space-8);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .screen-content {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .screen-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: rgba(192, 132, 252, 0.1);
    border: 1px solid rgba(192, 132, 252, 0.3);
    box-shadow: 0 0 20px rgba(192, 132, 252, 0.2);
    margin-bottom: var(--space-2);
  }

  .screen-heading {
    font-size: var(--text-lg);
    color: #ffffff;
  }

  .screen-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .controls-hint {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  .key-badge {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    color: var(--accent-gamedev);
  }

  .viewport-footer {
    padding: 10px 16px;
    background: rgba(14, 20, 34, 0.8);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
