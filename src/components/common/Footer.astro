---
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import { UI_TRANSLATIONS } from '../../i18n/ui';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const { locale = getLocaleFromUrl(pathname) } = Astro.props;
const t = UI_TRANSLATIONS[locale];
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-logo">
          <span class="brand-monogram">PR</span>
          <span class="brand-name">Pascual Ruiz Benítez</span>
        </div>
        <p class="footer-bio">{t.footer.bio}</p>
        <div class="status-indicator">
          <span class="status-dot"></span>
          <span class="status-text">{t.footer.status}</span>
        </div>
      </div>

      <div class="footer-columns">
        <div class="footer-col">
          <h4 class="col-title">{t.footer.pillarsTitle}</h4>
          <ul class="col-links">
            <li><a href={getLocalizedPath('/backend', locale)}>{t.nav.backend} (Spring/K8s)</a></li>
            <li><a href={getLocalizedPath('/trading', locale)}>{t.nav.trading} (MQL/Python)</a></li>
            <li><a href={getLocalizedPath('/gamedev', locale)}>{t.nav.gamedev} (Godot)</a></li>
            <li><a href={getLocalizedPath('/multimedia', locale)}>{t.nav.multimedia}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">{t.footer.quickAccessTitle}</h4>
          <ul class="col-links">
            <li><a href={getLocalizedPath('/cv', locale)}>{t.footer.cvLink}</a></li>
            <li><a href="https://github.com/pjrbenitez/pasruiben" target="_blank" rel="noopener noreferrer">{t.footer.githubLink}</a></li>
            <li><a href="mailto:pascualjavier.ruiz@policia.es">{t.footer.contactLink}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="copyright">
        &copy; {currentYear} Pascual Ruiz Benítez. {t.footer.copyright}
      </div>
      <div class="footer-meta">
        <span class="stack-badge">{t.footer.stack}</span>
        <span class="sep">&bull;</span>
        <span class="stack-badge">{t.footer.hosted}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-surface);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 480px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .brand-monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    background: linear-gradient(135deg, hsl(199, 89%, 48%), hsl(265, 89%, 66%));
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-xs);
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-text-primary);
  }

  .footer-bio {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    width: fit-content;
    margin-top: var(--space-2);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .status-text {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: #34d399;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-6);
  }

  .col-title {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .col-links a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .col-links a:hover {
    color: var(--accent-backend);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .sep {
    color: var(--color-border-default);
  }

  .stack-badge {
    font-family: var(--font-mono);
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 1.2fr 1fr;
    }
    .footer-bottom {
      flex-direction: row;
    }
  }
</style>
