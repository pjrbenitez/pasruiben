---
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import { UI_TRANSLATIONS } from '../../i18n/ui';
import type { Locale } from '../../i18n/languages';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const { locale = getLocaleFromUrl(pathname) } = Astro.props;
const t = UI_TRANSLATIONS[locale];

const isActive = (path: string) => {
  const fullPath = getLocalizedPath(path, locale);
  if (path === '/') {
    return pathname === fullPath || pathname === fullPath + '/' || (pathname.endsWith('/') ? pathname.slice(0, -1) === fullPath : false);
  }
  return pathname.startsWith(fullPath);
};

const navItems = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.backend, href: '/backend' },
  { label: t.nav.trading, href: '/trading' },
  { label: t.nav.gamedev, href: '/gamedev' },
  { label: t.nav.multimedia, href: '/multimedia' },
  { label: t.nav.cv, href: '/cv' },
];
---

<header class="site-header">
  <div class="container header-container">
    <a href={getLocalizedPath('/', locale)} class="brand-link" aria-label={t.header.ariaHome}>
      <span class="brand-monogram">PR</span>
      <div class="brand-text">
        <span class="brand-name">Pascual Ruiz</span>
        <span class="brand-role">{t.header.brandRole}</span>
      </div>
    </a>

    <nav class="desktop-nav" aria-label={t.header.ariaNav}>
      <ul class="nav-list">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={getLocalizedPath(item.href, locale)}
                class={active ? 'nav-link nav-link-active' : 'nav-link'}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <!-- Selector de Idioma con Banderas -->
      <LanguageSelector currentLocale={locale} />

      <a
        href="https://github.com/pjrbenitez/pasruiben"
        target="_blank"
        rel="noopener noreferrer"
        class="github-link"
        aria-label={t.header.ariaGithub}
      >
        <svg class="icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
      </a>

      <button
        id="mobile-menu-toggle"
        class="mobile-toggle"
        aria-label={t.header.ariaOpenMenu}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" aria-hidden="true">
    <ul class="mobile-nav-list">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <li>
            <a
              href={getLocalizedPath(item.href, locale)}
              class={active ? 'mobile-nav-link mobile-nav-link-active' : 'mobile-nav-link'}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-nav');

    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('mobile-nav-open', !isExpanded);
      menu.setAttribute('aria-hidden', String(isExpanded));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('mobile-nav-open');
        menu.setAttribute('aria-hidden', 'true');
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(7, 11, 19, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand-monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, hsl(199, 89%, 48%), hsl(265, 89%, 66%));
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-sm);
    letter-spacing: -0.04em;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.3);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .brand-role {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--accent-backend);
    line-height: 1.2;
  }

  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-elevated);
  }

  .nav-link-active {
    color: var(--accent-backend) !important;
    background: var(--accent-backend-subtle);
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .github-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .github-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-highlight);
    background: var(--color-bg-elevated);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 40px;
    height: 40px;
    padding: 10px 8px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: var(--radius-full);
    transition: all var(--transition-base);
  }

  .mobile-nav {
    display: none;
    background: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border-default);
    padding: var(--space-4) var(--space-6);
  }

  .mobile-nav.mobile-nav-open {
    display: block;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .mobile-nav-link-active {
    color: var(--accent-backend);
    background: var(--accent-backend-subtle);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
    .mobile-toggle {
      display: none;
    }
    .mobile-nav {
      display: none !important;
    }
  }
</style>
