---
import { LANGUAGES, type Locale } from '../../i18n/languages';
import { getLocaleFromUrl, getSwitchLocaleUrl } from '../../i18n/utils';
import { UI_TRANSLATIONS } from '../../i18n/ui';

interface Props {
  currentLocale?: Locale;
}

const pathname = Astro.url.pathname;
const { currentLocale = getLocaleFromUrl(pathname) } = Astro.props;
const currentLang = LANGUAGES.find((l) => l.code === currentLocale) || LANGUAGES[0];
const t = UI_TRANSLATIONS[currentLocale].languageSelector;
---

<details class="lang-selector-dropdown" id="lang-selector-details">
  <summary
    class="lang-btn"
    id="lang-btn"
    aria-label={`${t.label}: ${currentLang.name}`}
    title={`${t.label}: ${currentLang.name}`}
  >
    <span class="flag-wrapper" set:html={currentLang.flagSvg} />
    <span class="lang-code font-mono">{currentLang.code.toUpperCase()}</span>
    <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </summary>

  <div class="lang-menu" id="lang-menu" role="menu">
    <div class="lang-menu-header">
      <span class="menu-label font-mono">{t.label}</span>
    </div>
    <ul class="lang-list">
      {LANGUAGES.map((lang) => {
        const isSelected = lang.code === currentLocale;
        const targetUrl = getSwitchLocaleUrl(pathname, lang.code as Locale);
        return (
          <li role="none">
            <a
              href={targetUrl}
              class={`lang-option ${isSelected ? 'active' : ''}`}
              role="menuitem"
              aria-current={isSelected ? 'true' : undefined}
            >
              <span class="flag-wrapper" set:html={lang.flagSvg} />
              <span class="lang-name">{lang.localName}</span>
              {isSelected && (
                <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</details>

<script>
  function setupLangDropdown() {
    // Only bind global document listeners once across View Transitions
    if ((window as any).__langDropdownBound) return;
    (window as any).__langDropdownBound = true;

    // Close when clicking outside or clicking any language option
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const openDetails = document.querySelectorAll<HTMLDetailsElement>('details.lang-selector-dropdown[open]');
      
      openDetails.forEach((details) => {
        // If click is outside the details, or if click is on an option link inside
        if (!details.contains(target) || target.closest('.lang-option')) {
          details.removeAttribute('open');
        }
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const openDetails = document.querySelectorAll<HTMLDetailsElement>('details.lang-selector-dropdown[open]');
        openDetails.forEach((details) => details.removeAttribute('open'));
      }
    });
  }

  setupLangDropdown();
  document.addEventListener('astro:page-load', setupLangDropdown);
</script>

<style>
  .lang-selector-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
    user-select: none;
  }

  /* Reset native details / summary styles */
  .lang-selector-dropdown summary {
    list-style: none;
  }
  .lang-selector-dropdown summary::-webkit-details-marker,
  .lang-selector-dropdown summary::marker {
    display: none;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 40px;
    padding: 0 10px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    cursor: pointer;
    font-size: var(--text-xs);
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .lang-btn:hover {
    border-color: var(--color-border-highlight);
    background: var(--color-bg-elevated);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
  }

  .lang-selector-dropdown[open] .lang-btn {
    border-color: var(--accent-backend);
    background: var(--color-bg-elevated);
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.25);
  }

  .lang-code {
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .flag-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  :global(.flag-icon) {
    display: block;
    width: 20px;
    height: 14px;
    object-fit: cover;
  }

  .chevron-icon {
    color: var(--color-text-muted);
    transition: transform var(--transition-fast);
  }

  .lang-selector-dropdown[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .lang-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 160px;
    background: rgba(14, 20, 34, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7), 0 0 20px rgba(56, 189, 248, 0.15);
    padding: var(--space-2);
    z-index: 1000;
  }

  .lang-selector-dropdown[open] .lang-menu {
    display: block;
    animation: dropdownSlideDown 0.16s ease-out;
  }

  @keyframes dropdownSlideDown {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lang-menu-header {
    padding: var(--space-1) var(--space-3) var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: var(--space-1);
  }

  .menu-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .lang-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .lang-option:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-elevated);
  }

  .lang-option.active {
    color: var(--accent-backend);
    background: var(--accent-backend-subtle);
    font-weight: 600;
  }

  .lang-name {
    flex-grow: 1;
  }

  .check-icon {
    color: var(--accent-backend);
    margin-left: auto;
  }
</style>
