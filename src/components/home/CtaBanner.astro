---
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import { HOME_TRANSLATIONS } from '../../i18n/home';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const { locale = getLocaleFromUrl(pathname) } = Astro.props;
const t = HOME_TRANSLATIONS[locale].cta;
---

<section class="cta-section">
  <div class="container">
    <div class="cta-banner glass-panel">
      <div class="cta-glow"></div>
      <div class="cta-content">
        <span class="badge badge-backend">{t.badge}</span>
        <h2 class="cta-title">{t.title}</h2>
        <p class="cta-desc">{t.desc}</p>

        <div class="cta-actions">
          <a href="mailto:pascualjavier.ruiz@policia.es" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            {t.emailBtn}
          </a>
          <a href={getLocalizedPath('/cv', locale)} class="btn btn-outline">
            {t.cvBtn}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .cta-banner {
    position: relative;
    padding: var(--space-12) var(--space-8);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(14, 20, 34, 0.95), rgba(20, 30, 50, 0.9));
    border: 1px solid var(--color-border-highlight);
    overflow: hidden;
    text-align: center;
  }

  .cta-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .cta-title {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1.25;
  }

  .cta-desc {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
</style>
