---
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import { HOME_TRANSLATIONS } from '../../i18n/home';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const { locale = getLocaleFromUrl(pathname) } = Astro.props;
const t = HOME_TRANSLATIONS[locale].pillars;
---

<section class="pillars-section" id="especializaciones">
  <div class="container">
    <div class="section-intro">
      <div class="badge badge-backend">{t.introBadge}</div>
      <h2 class="section-title">{t.introTitle}</h2>
      <p class="section-subtitle">{t.introSubtitle}</p>
    </div>

    <div class="pillars-container">
      {t.items.map((pillar) => (
        <article class="pillar-card glass-panel" style={`--card-accent: ${pillar.accentVar};`}>
          <div class="pillar-card-header">
            <div class="pillar-number">{pillar.number}</div>
            <span class={`badge ${pillar.badgeClass}`}>{pillar.badge}</span>
          </div>

          <h3 class="pillar-heading">
            <a href={getLocalizedPath(pillar.href, locale)} class={pillar.gradientClass}>
              {pillar.title}
            </a>
          </h3>

          <p class="pillar-text">{pillar.desc}</p>

          <div class="pillar-features">
            <h4 class="features-title">{t.highlightsTitle}</h4>
            <ul class="features-list">
              {pillar.features.map((feat) => (
                <li>
                  <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pillar-footer">
            <div class="tech-pills">
              {pillar.tech.map((tech) => (
                <span class="tech-pill">{tech}</span>
              ))}
            </div>

            <a href={getLocalizedPath(pillar.href, locale)} class="pillar-action-btn">
              <span>{t.actionBtn}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-24);
  }

  .section-intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-16) auto;
  }

  .section-title {
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .pillars-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 850px) {
    .pillars-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    position: relative;
    overflow: hidden;
    transition: all var(--transition-smooth);
  }

  .pillar-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--card-accent);
    opacity: 0.6;
    transition: opacity var(--transition-base), height var(--transition-base);
  }

  .pillar-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-border-highlight);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 24px rgba(56, 189, 248, 0.08);
  }

  .pillar-card:hover::before {
    opacity: 1;
    height: 4px;
  }

  .pillar-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .pillar-number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .pillar-heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    font-weight: 700;
  }

  .pillar-heading a {
    text-decoration: none;
  }

  .pillar-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .pillar-features {
    background: rgba(7, 11, 19, 0.5);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .features-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .check-icon {
    color: var(--card-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pillar-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-pill {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    background: var(--color-bg-surface);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border-subtle);
  }

  .pillar-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: var(--font-display);
    text-decoration: none;
    border: 1px solid var(--color-border-default);
    transition: all var(--transition-fast);
  }

  .pillar-action-btn:hover {
    background: var(--card-accent);
    color: #070b13;
    border-color: var(--card-accent);
    box-shadow: 0 0 16px rgba(0, 0, 0, 0.4);
  }
</style>
