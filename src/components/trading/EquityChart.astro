---
interface Props {
  data: number[];
  title?: string;
  initialBalance?: number;
}

const {
  data = [10000, 11000, 12500, 14000, 16500, 18000, 21000, 24150],
  title = "Curva de Equidad Simulada (Normalizada a $10,000)",
  initialBalance = 10000,
} = Astro.props;

// Normalización de puntos para el SVG (Width: 700, Height: 260)
const svgWidth = 700;
const svgHeight = 260;
const paddingX = 40;
const paddingY = 30;

const minVal = Math.min(...data);
const maxVal = Math.max(...data);
const range = maxVal - minVal || 1;

const plotWidth = svgWidth - paddingX * 2;
const plotHeight = svgHeight - paddingY * 2;

const points = data.map((val, idx) => {
  const x = paddingX + (idx / (data.length - 1)) * plotWidth;
  const y = svgHeight - paddingY - ((val - minVal) / range) * plotHeight;
  return { x: Math.round(x), y: Math.round(y), val };
});

const pathString = points.reduce((acc, p, idx) => {
  return idx === 0 ? `M ${p.x} ${p.y}` : `${acc} L ${p.x} ${p.y}`;
}, '');

// Área de relleno bajo la curva
const areaString = `${pathString} L ${points[points.length - 1].x} ${svgHeight - paddingY} L ${points[0].x} ${svgHeight - paddingY} Z`;

const lastPoint = points[points.length - 1];
const finalReturn = Math.round(((lastPoint.val - initialBalance) / initialBalance) * 100);
---

<div class="equity-chart-card glass-panel">
  <div class="chart-header">
    <div class="chart-title-group">
      <span class="badge badge-trading">Rendimiento Auditado</span>
      <h3 class="chart-title">{title}</h3>
    </div>
    <div class="chart-stats">
      <div class="cs-item">
        <span class="cs-lbl">Retorno Total</span>
        <span class="cs-val cs-green">+{finalReturn}%</span>
      </div>
      <div class="cs-item">
        <span class="cs-lbl">Final Balance</span>
        <span class="cs-val">${lastPoint.val.toLocaleString()}</span>
      </div>
    </div>
  </div>

  <div class="chart-container">
    <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} class="chart-svg" preserveAspectRatio="none">
      <defs>
        <linearGradient id="equity-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
          <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
        </linearGradient>
      </defs>

      <!-- Guías horizontales -->
      <line x1={paddingX} y1={paddingY} x2={svgWidth - paddingX} y2={paddingY} stroke="rgba(255,255,255,0.08)" stroke-dasharray="3 3" />
      <line x1={paddingX} y1={svgHeight / 2} x2={svgWidth - paddingX} y2={svgHeight / 2} stroke="rgba(255,255,255,0.08)" stroke-dasharray="3 3" />
      <line x1={paddingX} y1={svgHeight - paddingY} x2={svgWidth - paddingX} y2={svgHeight - paddingY} stroke="rgba(255,255,255,0.15)" />

      <!-- Etiquetas de eje Y -->
      <text x={paddingX - 8} y={paddingY + 4} fill="#6b7280" font-family="monospace" font-size="10" text-anchor="end">${Math.round(maxVal).toLocaleString()}</text>
      <text x={paddingX - 8} y={svgHeight / 2 + 4} fill="#6b7280" font-family="monospace" font-size="10" text-anchor="end">${Math.round((maxVal + minVal) / 2).toLocaleString()}</text>
      <text x={paddingX - 8} y={svgHeight - paddingY + 4} fill="#6b7280" font-family="monospace" font-size="10" text-anchor="end">${Math.round(minVal).toLocaleString()}</text>

      <!-- Área y Línea de Equidad -->
      <path d={areaString} fill="url(#equity-gradient)" />
      <path d={pathString} fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

      <!-- Punto Final -->
      <circle cx={lastPoint.x} cy={lastPoint.y} r="5" fill="#10b981" stroke="#ffffff" stroke-width="2" />
    </svg>
  </div>

  <div class="chart-footer">
    <span>Eje X: Secuencia cronológica de operaciones out-of-sample</span>
    <span class="chart-tag">Datos brutos sin apalancamiento tóxico</span>
  </div>
</div>

<style>
  .equity-chart-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-default);
    margin-bottom: var(--space-10);
  }

  .chart-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .chart-header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .chart-title {
    font-size: var(--text-lg);
    margin-top: var(--space-2);
  }

  .chart-stats {
    display: flex;
    gap: var(--space-6);
  }

  .cs-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cs-lbl {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .cs-val {
    font-size: var(--text-base);
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .cs-green {
    color: var(--accent-trading);
  }

  .chart-container {
    width: 100%;
    height: 200px;
  }

  .chart-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .chart-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .chart-footer {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .chart-tag {
    font-family: var(--font-mono);
    color: var(--accent-trading);
  }
</style>
