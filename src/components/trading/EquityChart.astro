---
import { getLocaleFromUrl } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  data: number[];
  title?: string;
  initialBalance?: number;
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const {
  data = [10000, 11000, 12500, 14000, 16500, 18000, 21000, 24150],
  initialBalance = 10000,
  locale = getLocaleFromUrl(pathname),
  title,
} = Astro.props;

const isEn = locale === 'en';
const resolvedTitle = title || (isEn ? 'Simulated Equity Curve (Normalized to $10,000)' : 'Curva de Equidad Simulada (Normalizada a $10,000)');
const badgeText = isEn ? 'Audited Performance' : 'Rendimiento Auditado';
const totalReturnLabel = isEn ? 'Total Return' : 'Retorno Total';
const finalBalanceLabel = isEn ? 'Final Balance' : 'Balance Final';

// Normalización de puntos para el SVG (Width: 700, Height: 260)
const svgWidth = 700;
const svgHeight = 260;
const paddingX = 40;
const paddingY = 30;

const minVal = Math.min(...data);
const maxVal = Math.max(...data);
const range = maxVal - minVal || 1;

const plotWidth = svgWidth - paddingX * 2;
const plotHeight = svgHeight - paddingY * 2;

const points = data.map((val, idx) => {
  const x = paddingX + (idx / (data.length - 1)) * plotWidth;
  const y = svgHeight - paddingY - ((val - minVal) / range) * plotHeight;
  return { x: Math.round(x), y: Math.round(y), val };
});

const pathString = points.reduce((acc, p, idx) => {
  return idx === 0 ? `M ${p.x} ${p.y}` : `${acc} L ${p.x} ${p.y}`;
}, '');

// Área de relleno bajo la curva
const areaString = `${pathString} L ${points[points.length - 1].x} ${svgHeight - paddingY} L ${points[0].x} ${svgHeight - paddingY} Z`;

const lastPoint = points[points.length - 1];
const finalReturn = Math.round(((lastPoint.val - initialBalance) / initialBalance) * 100);
---

<div class="equity-chart-card glass-panel">
  <div class="chart-header">
    <div class="chart-title-group">
      <span class="badge badge-trading">{badgeText}</span>
      <h3 class="chart-title">{resolvedTitle}</h3>
    </div>
    <div class="chart-stats">
      <div class="cs-item">
        <span class="cs-lbl">{totalReturnLabel}</span>
        <span class="cs-val cs-green">+{finalReturn}%</span>
      </div>
      <div class="cs-item">
        <span class="cs-lbl">{finalBalanceLabel}</span>
        <span class="cs-val">${lastPoint.val.toLocaleString()}</span>
      </div>
    </div>
  </div>

  <div class="chart-container">
    <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} class="chart-svg" preserveAspectRatio="none">
      <defs>
        <linearGradient id="equity-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
          <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
        </linearGradient>
      </defs>

      <!-- Líneas de rejilla de fondo -->
      <line x1={paddingX} y1={paddingY} x2={svgWidth - paddingX} y2={paddingY} stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4" />
      <line x1={paddingX} y1={svgHeight / 2} x2={svgWidth - paddingX} y2={svgHeight / 2} stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4" />
      <line x1={paddingX} y1={svgHeight - paddingY} x2={svgWidth - paddingX} y2={svgHeight - paddingY} stroke="rgba(255,255,255,0.1)" />

      <!-- Área y Trazo -->
      <path d={areaString} fill="url(#equity-gradient)" />
      <path d={pathString} fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

      <!-- Puntos de inicio y fin -->
      <circle cx={points[0].x} cy={points[0].y} r="4" fill="#10b981" />
      <circle cx={lastPoint.x} cy={lastPoint.y} r="6" fill="#10b981" />
      <circle cx={lastPoint.x} cy={lastPoint.y} r="10" fill="#10b981" opacity="0.3" class="pulse-point" />
    </svg>
  </div>
</div>

<style>
  .equity-chart-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    margin-bottom: var(--space-12);
  }

  .chart-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .chart-header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .chart-title {
    font-size: var(--text-lg);
    margin-top: var(--space-2);
  }

  .chart-stats {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .cs-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cs-lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .cs-val {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .cs-green {
    color: var(--accent-trading);
  }

  .chart-container {
    width: 100%;
    height: 220px;
    background: rgba(7, 11, 19, 0.5);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    border: 1px solid var(--color-border-subtle);
  }

  .chart-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pulse-point {
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.3; }
    50% { transform: scale(1.5); opacity: 0.1; }
  }
</style>
