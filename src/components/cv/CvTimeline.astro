---
import { getLocaleFromUrl } from '../../i18n/utils';
import { CV_TRANSLATIONS } from '../../i18n/cv';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const { locale = getLocaleFromUrl(pathname) } = Astro.props;
const t = CV_TRANSLATIONS[locale].timeline;
---

<section class="cv-section">
  <div class="section-title-wrap">
    <div class="section-badge mono">{t.badge}</div>
    <h2 class="section-heading">{t.heading}</h2>
  </div>

  <div class="timeline-container">
    {t.items.map((exp) => (
      <article
        class="timeline-item glass-panel"
        data-tags={exp.tags.join(',')}
      >
        <div class="timeline-meta">
          <span class="period mono">{exp.period}</span>
          <span class="location">{exp.location}</span>
        </div>

        <div class="timeline-content">
          <div class="header-row">
            <div>
              <h3 class="role-title">{exp.role}</h3>
              <p class="company-name">{exp.company}</p>
            </div>
            <div class="tags-group no-print">
              {exp.tags.map((tag) => (
                <span class="tag-badge mono">{tag}</span>
              ))}
            </div>
          </div>

          <ul class="achievements-list">
            {exp.achievements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="tech-stack-row">
            <span class="stack-label mono">{t.stackLabel}</span>
            <div class="stack-pills">
              {exp.stack.map((tech) => (
                <span class="tech-pill mono">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .cv-section {
    margin-bottom: var(--space-12);
  }

  .section-title-wrap {
    margin-bottom: var(--space-6);
  }

  .section-badge {
    font-size: var(--text-xs);
    color: var(--color-accent-blue);
    margin-bottom: var(--space-1);
    letter-spacing: 0.05em;
  }

  .section-heading {
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .timeline-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    position: relative;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  @media (min-width: 768px) {
    .timeline-item {
      grid-template-columns: 180px 1fr;
      gap: var(--space-6);
    }
  }

  .timeline-item:hover {
    border-color: var(--color-border);
    transform: translateY(-2px);
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .period {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-blue);
  }

  .location {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .role-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .company-name {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .tags-group {
    display: flex;
    gap: var(--space-1);
  }

  .tag-badge {
    font-size: var(--text-xs);
    color: var(--color-accent-blue);
    background: rgba(56, 189, 248, 0.1);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .achievements-list {
    list-style-type: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .achievements-list li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    position: relative;
    padding-left: var(--space-4);
  }

  .achievements-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-accent-blue);
    font-weight: bold;
  }

  .tech-stack-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-3);
  }

  .stack-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tech-pill {
    font-size: var(--text-xs);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-secondary);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
  }
</style>