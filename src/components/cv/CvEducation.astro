---
import { getLocaleFromUrl } from '../../i18n/utils';
import { CV_TRANSLATIONS } from '../../i18n/cv';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const { locale = getLocaleFromUrl(pathname) } = Astro.props;
const t = CV_TRANSLATIONS[locale].education;
---

<section class="cv-section">
  <div class="section-title-wrap">
    <div class="section-badge mono">{t.badge}</div>
    <h2 class="section-heading">{t.heading}</h2>
  </div>

  <div class="edu-grid">
    <div class="edu-column glass-panel">
      <h3 class="col-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
          <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
        </svg>
        <span>{t.formalTitle}</span>
      </h3>

      <div class="items-list">
        {t.items.map((item) => (
          <div class="edu-item">
            <div class="edu-header">
              <h4 class="edu-degree">{item.degree}</h4>
              <span class="edu-period mono">{item.period}</span>
            </div>
            <p class="edu-inst">{item.institution}</p>
            <p class="edu-notes">{item.notes}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="edu-column glass-panel">
      <h3 class="col-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="8" r="7"></circle>
          <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
        </svg>
        <span>{t.certsTitle}</span>
      </h3>

      <div class="items-list">
        {t.certifications.map((cert) => (
          <div class="cert-item">
            <div class="cert-header">
              <span class="cert-title">{cert.title}</span>
              <span class="cert-year mono">{cert.year}</span>
            </div>
            <span class="cert-issuer">{cert.issuer}</span>
          </div>
        ))}
      </div>

      <div class="languages-block">
        <h4 class="lang-heading mono">{t.langTitle}</h4>
        <div class="lang-list">
          {t.languages.map((l) => (
            <div class="lang-row">
              <span class="lang-name"><strong>{l.lang}:</strong> {l.level}</span>
              <span class="lang-desc">{l.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cv-section {
    margin-bottom: var(--space-12);
  }

  .section-title-wrap {
    margin-bottom: var(--space-6);
  }

  .section-badge {
    font-size: var(--text-xs);
    color: var(--color-accent-blue);
    margin-bottom: var(--space-1);
    letter-spacing: 0.05em;
  }

  .section-heading {
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .edu-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .edu-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .edu-column {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
  }

  .col-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .col-title svg {
    color: var(--color-accent-blue);
  }

  .items-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .edu-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .edu-degree {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .edu-period {
    font-size: var(--text-xs);
    color: var(--color-accent-blue);
  }

  .edu-inst {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .edu-notes {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .cert-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cert-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .cert-title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .cert-year {
    font-size: 11px;
    color: var(--color-accent-blue);
  }

  .cert-issuer {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .languages-block {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .lang-heading {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    letter-spacing: 0.05em;
  }

  .lang-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .lang-row {
    display: flex;
    flex-direction: column;
    font-size: var(--text-xs);
  }

  .lang-name {
    color: var(--color-text-primary);
  }

  .lang-desc {
    color: var(--color-text-muted);
    font-size: 11px;
  }
</style>