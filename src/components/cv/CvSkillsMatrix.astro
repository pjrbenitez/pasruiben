---
import { getLocaleFromUrl } from '../../i18n/utils';
import { CV_TRANSLATIONS } from '../../i18n/cv';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const { locale = getLocaleFromUrl(pathname) } = Astro.props;
const t = CV_TRANSLATIONS[locale].skills;
---

<section class="cv-section">
  <div class="section-title-wrap">
    <div class="section-badge mono">{t.badge}</div>
    <h2 class="section-heading">{t.heading}</h2>
  </div>

  <div class="skills-grid">
    {t.categories.map((cat) => (
      <div class="skill-category-card glass-panel">
        <h3 class="category-title">
          <span class="bullet"></span>
          <span>{cat.title}</span>
        </h3>

        <div class="skills-list">
          {cat.skills.map((skill) => (
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name mono">{skill.name}</span>
                <span class="skill-level">{skill.level}</span>
              </div>
              {skill.note && (
                <p class="skill-note">{skill.note}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .cv-section {
    margin-bottom: var(--space-12);
  }

  .section-title-wrap {
    margin-bottom: var(--space-6);
  }

  .section-badge {
    font-size: var(--text-xs);
    color: var(--color-accent-blue);
    margin-bottom: var(--space-1);
    letter-spacing: 0.05em;
  }

  .section-heading {
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-category-card {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
  }

  .category-title {
    font-size: var(--text-base);
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .category-title .bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-blue);
  }

  .skills-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .skill-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .skill-name {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .skill-level {
    font-size: 10px;
    color: var(--color-accent-blue);
    font-weight: 500;
  }

  .skill-note {
    font-size: 11px;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }
</style>