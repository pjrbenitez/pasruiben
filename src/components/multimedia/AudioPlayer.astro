---
interface Props {
  title?: string;
  composer?: string;
  duration?: string;
  waveform?: number[];
  category?: string;
}

const {
  title = "Nocturno en Do Menor, Op. 48 No. 1",
  composer = "Frédéric Chopin",
  duration = "6:15",
  waveform = [20, 35, 25, 40, 50, 45, 60, 55, 70, 65, 80, 75, 90, 85, 95, 100, 92, 85, 78, 65, 50, 40, 30, 25],
  category = "Piano Clásico Lossless",
} = Astro.props;
---

<div class="audio-player-card glass-panel" id="custom-audio-player">
  <div class="player-top">
    <div class="track-info">
      <span class="badge badge-media">{category}</span>
      <h3 class="track-title">{title}</h3>
      <span class="track-composer">{composer} &bull; Grabación Acústica de Alta Fidelidad</span>
    </div>

    <div class="lossless-indicator">
      <span class="sound-wave-icon">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </span>
      <span class="audio-badge-text">24-bit / 96 kHz Lossless</span>
    </div>
  </div>

  <!-- Interactive Controls & Waveform Simulation -->
  <div class="player-controls-strip">
    <!-- Play/Pause Button -->
    <button class="play-btn" id="player-play-toggle" aria-label="Reproducir o pausar audio">
      <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <svg class="icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
        <rect x="6" y="4" width="4" height="16"></rect>
        <rect x="14" y="4" width="4" height="16"></rect>
      </svg>
    </button>

    <!-- Time Counter -->
    <span class="time-display" id="time-current">0:00</span>

    <!-- Waveform Visualizer -->
    <div class="waveform-container" id="waveform-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
      <div class="waveform-progress" id="waveform-fill"></div>
      <div class="waveform-bars">
        {waveform.map((height) => (
          <div class="w-bar" style={`height: ${height}%;`}></div>
        ))}
      </div>
    </div>

    <!-- Duration -->
    <span class="time-display time-total">{duration}</span>
  </div>

  <div class="player-footer">
    <span class="recording-note">Micrófonos: Par estéreo ORTF &bull; Mecánica de cola acústica</span>
    <span class="master-tag">Mastering Dinámico sin Compresión Destructiva</span>
  </div>
</div>

<script>
  function initAudioPlayer() {
    const playBtn = document.getElementById('player-play-toggle');
    const playIcon = playBtn?.querySelector('.icon-play') as HTMLElement;
    const pauseIcon = playBtn?.querySelector('.icon-pause') as HTMLElement;
    const timeDisplay = document.getElementById('time-current');
    const waveformFill = document.getElementById('waveform-fill');
    const soundWave = document.querySelector('.sound-wave-icon');

    if (!playBtn) return;

    let isPlaying = false;
    let progress = 0;
    let timer: number | null = null;

    playBtn.addEventListener('click', () => {
      isPlaying = !isPlaying;

      if (isPlaying) {
        if (playIcon) playIcon.style.display = 'none';
        if (pauseIcon) pauseIcon.style.display = 'block';
        if (soundWave) soundWave.classList.add('playing');

        timer = window.setInterval(() => {
          progress = (progress + 0.5) % 100;
          if (waveformFill) waveformFill.style.width = `${progress}%`;

          // Formatear segundos aproximados
          const totalSec = Math.round((progress / 100) * 375); // 6:15 = 375s
          const mins = Math.floor(totalSec / 60);
          const secs = totalSec % 60;
          if (timeDisplay) timeDisplay.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }, 300);
      } else {
        if (playIcon) playIcon.style.display = 'block';
        if (pauseIcon) pauseIcon.style.display = 'none';
        if (soundWave) soundWave.classList.remove('playing');
        if (timer) clearInterval(timer);
      }
    });
  }

  initAudioPlayer();
  document.addEventListener('astro:page-load', initAudioPlayer);
</script>

<style>
  .audio-player-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-default);
    margin-bottom: var(--space-12);
    background: linear-gradient(135deg, rgba(14, 20, 34, 0.95), rgba(28, 22, 12, 0.6));
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 30px rgba(251, 191, 36, 0.08);
  }

  .player-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .player-top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .track-title {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
    color: var(--color-text-primary);
  }

  .track-composer {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--accent-media);
  }

  .lossless-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.25);
    width: fit-content;
  }

  .sound-wave-icon {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .bar {
    width: 2px;
    background: var(--accent-media);
    border-radius: 1px;
    height: 4px;
    transition: height 0.2s ease;
  }

  .sound-wave-icon.playing .bar-1 { animation: soundAnim 0.8s infinite ease-in-out alternate; }
  .sound-wave-icon.playing .bar-2 { animation: soundAnim 0.6s infinite ease-in-out alternate 0.2s; }
  .sound-wave-icon.playing .bar-3 { animation: soundAnim 0.9s infinite ease-in-out alternate 0.4s; }

  @keyframes soundAnim {
    0% { height: 3px; }
    100% { height: 12px; }
  }

  .audio-badge-text {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--accent-media);
  }

  .player-controls-strip {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background: rgba(7, 11, 19, 0.7);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
  }

  .play-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--accent-media);
    color: #070b13;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-fast);
    box-shadow: 0 0 16px rgba(251, 191, 36, 0.35);
  }

  .play-btn:hover {
    background: #f59e0b;
    transform: scale(1.06);
    box-shadow: 0 0 24px rgba(251, 191, 36, 0.5);
  }

  .time-display {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    min-width: 35px;
  }

  .time-total {
    color: var(--color-text-muted);
  }

  .waveform-container {
    flex-grow: 1;
    height: 36px;
    position: relative;
    display: flex;
    align-items: center;
    cursor: pointer;
    overflow: hidden;
  }

  .waveform-progress {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 0%;
    background: rgba(251, 191, 36, 0.2);
    border-right: 2px solid var(--accent-media);
    transition: width 0.1s linear;
  }

  .waveform-bars {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3px;
  }

  .w-bar {
    flex: 1;
    background: rgba(251, 191, 36, 0.4);
    border-radius: 2px;
    transition: background 0.15s ease;
  }

  .w-bar:hover {
    background: var(--accent-media);
  }

  .player-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .player-footer {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .master-tag {
    font-family: var(--font-mono);
    color: var(--accent-media);
  }
</style>
