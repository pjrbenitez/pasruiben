---
import { getLocaleFromUrl } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  title?: string;
  composer?: string;
  duration?: string;
  waveform?: number[];
  category?: string;
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const {
  locale = getLocaleFromUrl(pathname),
  duration = "6:15",
  waveform = [20, 35, 25, 40, 50, 45, 60, 55, 70, 65, 80, 75, 90, 85, 95, 100, 92, 85, 78, 65, 50, 40, 30, 25],
  category: customCategory,
  title: customTitle,
  composer: customComposer,
} = Astro.props;

const isEn = locale === 'en';
const title = customTitle || (isEn ? "Nocturne in C Minor, Op. 48 No. 1" : "Nocturno en Do Menor, Op. 48 No. 1");
const composer = customComposer || (isEn ? "Frédéric Chopin" : "Frédéric Chopin");
const category = customCategory || (isEn ? "Classical Piano Lossless" : "Piano Clásico Lossless");

const subLabel = isEn ? "High-Fidelity Acoustic Recording" : "Grabación Acústica de Alta Fidelidad";
const ariaPlay = isEn ? "Play or pause audio playback" : "Reproducir o pausar audio";
const micNote = isEn ? "Microphones: ORTF Stereo Pair • Acoustic grand action" : "Micrófonos: Par estéreo ORTF • Mecánica de cola acústica";
const masterTag = isEn ? "Dynamic Mastering without Destructive Compression" : "Mastering Dinámico sin Compresión Destructiva";
---

<div class="audio-player-card glass-panel" id="custom-audio-player">
  <div class="player-top">
    <div class="track-info">
      <span class="badge badge-media">{category}</span>
      <h3 class="track-title">{title}</h3>
      <span class="track-composer">{composer} &bull; {subLabel}</span>
    </div>

    <div class="lossless-indicator">
      <span class="sound-wave-icon">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </span>
      <span class="audio-badge-text">24-bit / 96 kHz Lossless</span>
    </div>
  </div>

  <!-- Interactive Controls & Waveform Simulation -->
  <div class="player-controls-strip">
    <!-- Play/Pause Button -->
    <button class="play-btn" id="player-play-toggle" aria-label={ariaPlay}>
      <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <svg class="icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
        <rect x="6" y="4" width="4" height="16"></rect>
        <rect x="14" y="4" width="4" height="16"></rect>
      </svg>
    </button>

    <!-- Time Counter -->
    <span class="time-display" id="time-current">0:00</span>

    <!-- Waveform Visualizer -->
    <div class="waveform-container" id="waveform-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
      <div class="waveform-progress" id="waveform-fill"></div>
      <div class="waveform-bars">
        {waveform.map((height) => (
          <div class="w-bar" style={`height: ${height}%;`}></div>
        ))}
      </div>
    </div>

    <!-- Duration -->
    <span class="time-display time-total">{duration}</span>
  </div>

  <div class="player-footer">
    <span class="recording-note">{micNote}</span>
    <span class="master-tag">{masterTag}</span>
  </div>
</div>

<script>
  function initAudioPlayer() {
    const playBtn = document.getElementById('player-play-toggle');
    const playIcon = playBtn?.querySelector('.icon-play') as HTMLElement;
    const pauseIcon = playBtn?.querySelector('.icon-pause') as HTMLElement;
    const timeDisplay = document.getElementById('time-current');
    const waveformFill = document.getElementById('waveform-fill');
    const soundWave = document.querySelector('.sound-wave-icon');

    if (!playBtn) return;

    let isPlaying = false;
    let progress = 0;
    let timer: number | null = null;

    playBtn.addEventListener('click', () => {
      isPlaying = !isPlaying;

      if (isPlaying) {
        if (playIcon) playIcon.style.display = 'none';
        if (pauseIcon) pauseIcon.style.display = 'block';
        if (soundWave) soundWave.classList.add('playing');

        timer = window.setInterval(() => {
          progress = (progress + 0.5) % 100;
          if (waveformFill) waveformFill.style.width = `${progress}%`;

          // Formatear segundos aproximados
          const totalSec = Math.round((progress / 100) * 375); // 6:15 = 375s
          const mins = Math.floor(totalSec / 60);
          const secs = totalSec % 60;
          if (timeDisplay) timeDisplay.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }, 300);
      } else {
        if (playIcon) playIcon.style.display = 'block';
        if (pauseIcon) pauseIcon.style.display = 'none';
        if (soundWave) soundWave.classList.remove('playing');
        if (timer) clearInterval(timer);
      }
    });
  }

  initAudioPlayer();
  document.addEventListener('astro:page-load', initAudioPlayer);
</script>

<style>
  .audio-player-card {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    margin-bottom: var(--space-12);
  }

  .player-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .player-top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .track-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .track-composer {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .lossless-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .sound-wave-icon {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .bar {
    width: 3px;
    background: var(--accent-media);
    border-radius: 1px;
  }

  .bar-1 { height: 6px; }
  .bar-2 { height: 14px; }
  .bar-3 { height: 9px; }

  .sound-wave-icon.playing .bar-1 { animation: soundBar 0.8s infinite alternate ease-in-out; }
  .sound-wave-icon.playing .bar-2 { animation: soundBar 0.5s infinite alternate ease-in-out 0.2s; }
  .sound-wave-icon.playing .bar-3 { animation: soundBar 0.7s infinite alternate ease-in-out 0.4s; }

  @keyframes soundBar {
    from { height: 4px; }
    to { height: 14px; }
  }

  .audio-badge-text {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--accent-media);
    font-weight: 600;
  }

  .player-controls-strip {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background: rgba(7, 11, 19, 0.6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .play-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent-media);
    color: #070b13;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .play-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.5);
  }

  .time-display {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    min-width: 32px;
  }

  .waveform-container {
    flex-grow: 1;
    height: 36px;
    position: relative;
    display: flex;
    align-items: center;
  }

  .waveform-bars {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3px;
  }

  .w-bar {
    flex: 1;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    min-height: 4px;
    transition: background var(--transition-fast);
  }

  .waveform-progress {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 0%;
    background: rgba(245, 158, 11, 0.2);
    border-right: 2px solid var(--accent-media);
    pointer-events: none;
    z-index: 2;
    transition: width 0.1s linear;
  }

  .player-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .player-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .master-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-media);
  }
</style>
