---
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  work: {
    slug: string;
    data: {
      title: string;
      description: string;
      category: string;
      composer?: string;
      opus?: string;
      difficulty: string;
      duration: string;
      recordingSpecs: {
        sampleRate: string;
        bitDepth: string;
        microphones: string;
      };
      highlights: string[];
      featured: boolean;
    };
  };
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const { work, locale = getLocaleFromUrl(pathname) } = Astro.props;
const { slug, data } = work;
const cleanSlug = slug.replace(/^(en|es)\//, '');

const isEn = locale === 'en';
const resolutionLabel = isEn ? 'Bit Depth' : 'Resolución';
const captureLabel = isEn ? 'Acoustic Capture' : 'Captura Acústica';
const notesHeading = isEn ? 'Performance Details' : 'Detalles de Interpretación';
const diffLabel = isEn ? 'Difficulty' : 'Dificultad';
const btnLabel = isEn ? 'Audio & Notes' : 'Notas & Reproductor';
---

<article class="performance-card glass-panel">
  <div class="card-header">
    <div class="header-badges">
      <span class="badge badge-media">{data.category}</span>
      {data.composer && <span class="composer-badge">{data.composer}</span>}
    </div>
    <span class="duration-badge">{data.duration}</span>
  </div>

  <h3 class="perf-title">
    <a href={getLocalizedPath(`/multimedia/${cleanSlug}`, locale)}>
      {data.title}
    </a>
  </h3>

  <p class="perf-desc">{data.description}</p>

  <!-- Ficha de Grabación -->
  <div class="recording-strip">
    <div class="rec-box">
      <span class="rec-val">{data.recordingSpecs.sampleRate}</span>
      <span class="rec-lbl">Sample Rate</span>
    </div>
    <div class="rec-box">
      <span class="rec-val">{data.recordingSpecs.bitDepth}</span>
      <span class="rec-lbl">{resolutionLabel}</span>
    </div>
    <div class="rec-box rec-wide">
      <span class="rec-val rec-small">{data.recordingSpecs.microphones}</span>
      <span class="rec-lbl">{captureLabel}</span>
    </div>
  </div>

  <!-- Puntos Clave de la Interpretación -->
  <div class="notes-box">
    <h4 class="notes-heading">{notesHeading}</h4>
    <ul class="notes-list">
      {data.highlights.slice(0, 3).map((h) => (
        <li>
          <svg class="n-bullet" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{h}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="card-footer">
    <span class="diff-tag">{diffLabel}: {data.difficulty}</span>

    <a href={getLocalizedPath(`/multimedia/${cleanSlug}`, locale)} class="btn-listen-work">
      <span>{btnLabel}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .performance-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    transition: all var(--transition-base);
  }

  .performance-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.4);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 24px rgba(245, 158, 11, 0.1);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .composer-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .duration-badge {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--accent-media);
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .perf-title {
    font-size: var(--text-xl);
    line-height: 1.3;
    margin-bottom: var(--space-3);
  }

  .perf-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .perf-title a:hover {
    color: var(--accent-media);
  }

  .perf-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .recording-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    background: rgba(7, 11, 19, 0.6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .recording-strip {
      grid-template-columns: 1fr 1fr 2fr;
    }
  }

  .rec-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rec-val {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--accent-media);
  }

  .rec-small {
    font-size: 11px;
    color: var(--color-text-secondary);
  }

  .rec-lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .notes-box {
    margin-bottom: var(--space-6);
  }

  .notes-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .notes-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .notes-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .n-bullet {
    color: var(--accent-media);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .diff-tag {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .btn-listen-work {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent-media);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--accent-media-subtle);
    border: 1px solid rgba(245, 158, 11, 0.2);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .btn-listen-work:hover {
    background: var(--accent-media);
    color: #070b13;
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.4);
  }
</style>
